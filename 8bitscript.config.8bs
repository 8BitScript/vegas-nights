export default {
  // One project, many lab programs. Each program is its own build from its
  // own `.8bs` entry and writes dist/<program>-<target>.prg (dist/web/<program>/
  // on the web once there is more than one). Add a lab by adding a line here
  // and a directory under src/labs/ — see README.md, "Adding a lab".
  //
  // `main` is the lobby, and it has to exist: with several programs and none
  // named `main`, `8bs run`/`8bs build` stop and ask for --program, and the
  // editor's Run button does not pass one. Labs are run by name.
  programs: {
    main: { entry: 'src/lobby/main.8bs' },
    'hello-reels': { entry: 'src/labs/hello-reels/main.8bs' },
    // The tiles pipeline's proof: every symbol and a reel window at rest. The web joins
    // when its redefinable glyph table (8bitscript #303) is in a release.
    'tile-test': { entry: 'src/labs/tile-test/main.8bs', targets: ['pet', 'vic20', 'c64', 'cx16'] },
    slot3x3: { entry: 'src/labs/slot3x3/main.8bs' },
    // The same machine taking spins by itself from a fixed seed — what the screenshot
    // tests run, because a headless capture cannot press a key. Each seed is picked to
    // show something: a loss, a two-line win, small wins, the jackpot.
    'slot3x3-lose': { entry: 'src/labs/slot3x3/lose.8bs' },
    'slot3x3-lines': { entry: 'src/labs/slot3x3/lines.8bs' },
    'slot3x3-cherries': { entry: 'src/labs/slot3x3/cherries.8bs' },
    'slot3x3-jackpot': { entry: 'src/labs/slot3x3/jackpot.8bs' },
    // Test support, not games: a ruler that prints two letters a known number
    // of cells apart (so a screenshot's cell size can be measured), and a
    // sheet of every symbol and digit exactly as the game draws them.
    'slot3x3-probe': { entry: 'src/labs/slot3x3/probe.8bs' },
    'slot3x3-ruler': { entry: 'src/labs/slot3x3/ruler.8bs' },
    'slot3x3-glyphs': { entry: 'src/labs/slot3x3/glyphs.8bs' },
  },
  // The machine the labs are designed on: every fact they test is true on
  // it, and `8bs build --release` reports what each other build is short of
  // (README.md, "The baseline").
  baseline: 'c64',
  imports: {
    '@shared': 'src/shared',
    '@generated': 'src/generated',
  },
  // The five machines this release of 8BitScript builds for. The PET is the
  // 32K 4032 and the VIC-20 the 8K expansion: the smaller stock machines are
  // below what a lab needs (PET 2001 has 4K; the unexpanded VIC-20 about 3.5K).
  targets: {
    pet: { hardware: { model: '4032', ram: '32' } },
    vic20: { hardware: { ram: '8k' } },
    c64: {},
    cx16: {},
    web: {},
  },
};
