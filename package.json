{
  "name": "vegas-nights",
  "version": "0.0.0",
  "private": true,
  "description": "Vegas Nights: a lab for modern-style slot machines with real odds, in 8BitScript, from one source tree, on the PET, VIC-20, C64, Commander X16, and the web.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "8bs run c64",
    "start:pet": "8bs run pet",
    "start:vic20": "8bs run vic20",
    "start:c64": "8bs run c64",
    "start:cx16": "8bs run cx16",
    "start:web": "8bs run web",
    "start:hello-reels": "8bs run c64 --program hello-reels",
    "start:hello-reels:pet": "8bs run pet --program hello-reels",
    "start:hello-reels:vic20": "8bs run vic20 --program hello-reels",
    "start:hello-reels:c64": "8bs run c64 --program hello-reels",
    "start:hello-reels:cx16": "8bs run cx16 --program hello-reels",
    "start:hello-reels:web": "8bs run web --program hello-reels",
    "shot:hello-reels": "node scripts/shot.mjs hello-reels",
    "start:sound-test": "8bs run c64 --program sound-test",
    "start:sound-test:pet": "8bs run pet --program sound-test",
    "start:sound-test:vic20": "8bs run vic20 --program sound-test",
    "start:sound-test:c64": "8bs run c64 --program sound-test",
    "start:sound-test:cx16": "8bs run cx16 --program sound-test",
    "start:sound-test:web": "8bs run web --program sound-test",
    "sound": "node scripts/sound.mjs",
    "sound:slot": "node scripts/slot-sound.mjs",
    "build": "8bs build --release",
    "build:pet": "8bs build --target pet",
    "build:vic20": "8bs build --target vic20",
    "build:c64": "8bs build --target c64",
    "build:cx16": "8bs build --target cx16",
    "build:web": "8bs build --target web",
    "check": "8bs check src/lobby/main.8bs src/labs/hello-reels/main.8bs src/labs/slot3x3/main.8bs src/labs/slot5x5/main.8bs src/shared/reels.8bs src/labs/sound-test/main.8bs src/shared/sfx.8bs src/shared/fx.8bs",
    "tiles:art": "node tools/tiles/bin/tiles.mjs art",
    "tiles:build": "node tools/tiles/bin/tiles.mjs build",
    "tiles:check": "node tools/tiles/bin/tiles.mjs check",
    "tiles:preview": "node tools/tiles/bin/tiles.mjs preview",
    "test:tiles": "node --test tools/tiles/test/",
    "start:tile-test": "8bs run c64 --program tile-test",
    "start:tile-test:pet": "8bs run pet --program tile-test",
    "start:tile-test:vic20": "8bs run vic20 --program tile-test",
    "start:tile-test:c64": "8bs run c64 --program tile-test",
    "start:tile-test:cx16": "8bs run cx16 --program tile-test",
    "shot:tile-test": "node scripts/shot.mjs tile-test pet vic20 c64 cx16",
    "start:slot3x3": "8bs run c64 --program slot3x3",
    "start:slot3x3:pet": "8bs run pet --program slot3x3",
    "start:slot3x3:vic20": "8bs run vic20 --program slot3x3",
    "start:slot3x3:c64": "8bs run c64 --program slot3x3",
    "start:slot3x3:cx16": "8bs run cx16 --program slot3x3",
    "start:slot3x3:web": "8bs run web --program slot3x3",
    "shot:slot3x3": "node scripts/shot.mjs slot3x3",
    "start:slot5x5": "8bs run c64 --program slot5x5",
    "start:slot5x5:pet": "8bs run pet --program slot5x5",
    "start:slot5x5:vic20": "8bs run vic20 --program slot5x5",
    "start:slot5x5:c64": "8bs run c64 --program slot5x5",
    "start:slot5x5:cx16": "8bs run cx16 --program slot5x5",
    "start:slot5x5:web": "8bs run web --program slot5x5",
    "shot:slot5x5": "node scripts/shot.mjs slot5x5",
    "test": "node --test test/odds.test.mjs test/odds5.test.mjs test/fx.test.mjs test/glyph-budget.test.mjs test/panel.test.mjs",
    "test:machines": "node --test test/machines.test.mjs test/slot5x5.machines.test.mjs test/fx.machines.test.mjs test/composer-offsets.test.mjs test/hops.test.mjs",
    "test:c64web": "MACHINES=c64web node --test test/machines.test.mjs test/slot5x5.machines.test.mjs test/fx.machines.test.mjs test/composer-offsets.test.mjs test/hops.test.mjs",
    "motion": "node scripts/motion.mjs",
    "motion:plan": "node scripts/motion-plan.mjs"
  },
  "devDependencies": {
    "@8bitscript/cli": "0.24.0"
  },
  "dependencies": {
    "@8bitscript/audio": "0.24.0",
    "@8bitscript/graphics": "0.24.0",
    "@8bitscript/i18n": "0.24.0",
    "@8bitscript/input": "0.24.0",
    "@8bitscript/pointer": "0.24.0",
    "@8bitscript/random": "0.24.0",
    "@8bitscript/raster": "0.24.0",
    "@8bitscript/screen": "0.24.0",
    "@8bitscript/sprites": "0.24.0",
    "@8bitscript/system": "0.24.0",
    "@8bitscript/text": "0.24.0",
    "@8bitscript/pet": "0.24.0",
    "@8bitscript/vic20": "0.24.0",
    "@8bitscript/c64": "0.24.0",
    "@8bitscript/cx16": "0.24.0",
    "@8bitscript/web": "0.24.0"
  }
}
