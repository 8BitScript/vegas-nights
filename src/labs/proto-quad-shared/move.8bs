// Move a block of screen bytes down one row (design prototype, docs/reel-size.md): the whole-cell scroll of a
// reel is `width` bytes copied from each row to the one below it, bottom row first, 18 cycles a byte.
export namespace move {
    // `top` is the address of the block's first byte, `rows` its height, `width` its width, `stride` the
    // distance between rows (the screen's columns). The top row is left as it was; the caller composes it.
    function down(top: usmallint, rows: utinyint, width: utinyint, stride: utinyint): void {
        let dst: usmallint = rows - 1;
        dst = dst * stride + top;
        let src: usmallint = dst - stride;
        let n: utinyint = rows - 1;
        asm6502 {
        1:
            ldy width
        2:
            dey
            lda (src),y
            sta (dst),y
            cpy #0
            bne 2b
            sec
            lda dst
            sbc stride
            sta dst
            bcs 3f
            dec dst+1
        3:
            sec
            lda src
            sbc stride
            sta src
            bcs 4f
            dec src+1
        4:
            dec n
            bne 1b
        }
    }
}
