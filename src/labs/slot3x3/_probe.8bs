import { screen } from "@8bitscript/screen";
import { text } from "@8bitscript/text";
import { layout } from "@shared/layout.8bs";
import { view } from "./view.8bs";
import { reelscroll } from "@shared/reelscroll.8bs";
export function main(): void {
    screen.blank();
    layout.centre(13);
    for (let reel: utinyint = 0; reel < 3; reel++) { reelscroll.place(reel, 0); }
    view.begin();
    for (let i: usmallint = 0; i < 60; i++) { reelscroll.place(0, 5); view.draw(0); }
    text.print(layout.cell(1, 22), "DONE");
    while (true) { waitFrame(); }
}
