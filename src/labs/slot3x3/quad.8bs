// The reels from the quadrant blocks every Commodore character ROM holds (and the web's host font): a character
// cell is a 2x2 picture, so the screen is a grid of "pseudo-pixels" four real pixels on a side. Used by the PET
// (whose ROM is fixed, so there are no glyphs to redefine), the VIC-20 (whose RAM has no room reserved for a
// character set yet) and the web. A symbol is QUAD_S x QUAD_S cells (6 x 6 on the 3x3: 48 pixels a side, twice
// what the first version drew), and a reel scrolls one pseudo-pixel row, four real pixels, at a time.
//
// Every display cell is built from two consecutive pseudo-pixel rows of the window, so its screen code is one
// of three precomputed tables (tools/tiles/src/quadtables.mjs): QUAD_C0 when the pair starts on an even row,
// QUAD_C1 on an odd one, QUAD_CX where an odd pair straddles two symbols. A redraw is one table read and one
// write a cell; where the machine's screen is in memory (scr.COPY) a reel that moves a whole cell row, eight
// pixels, does not even do that: it MOVES its cells down one row with a 6502 block copy (the hop,
// shared/move.8bs) and composes only the new top row. The picture is exactly the one a full redraw makes.
//
// A machine's `cells` writes the raw screen code (and, where there is colour, an ink) down; `view` wraps
// this with the interface the game calls.
use @8bitscript::text::text;
use "@shared/cells.8bs"::cells;
use "@shared/layout.8bs"::layout;
use "@shared/move.8bs"::move;
use "@shared/reelscroll.8bs"::reelscroll;
use "@shared/scr.8bs"::scr;
use "@generated/classic3x3.8bs"::{REELS, ROWS, STOPS, STOP_MASK, STRIPS, LINES};
use "@generated/tiles/classic.quad.8bs"::{QUAD_S, QUAD_P, QUAD_SYMBOLS, QUAD_C0, QUAD_C1, QUAD_CX, QUAD_K};
use "@generated/tiles/classic.pet.8bs"::{FRAME_TL, FRAME_T, FRAME_TR, FRAME_L, FRAME_R, FRAME_BL, FRAME_B, FRAME_BR, FRAME_DIV, FRAME_DIVT, FRAME_DIVB, FRAME_ARROW_L, FRAME_ARROW_R};

// Per reel: the stop and pseudo-pixel row last drawn (so a 2-pixel step that does not reach the next row costs
// nothing, and a whole-cell move is told from a jump), and which of its symbol rows are shown inverted (the
// win flash).
let mut drawnRow: [utinyint; 3];
let mut drawnStop: [utinyint; 3];
let mut inverted: [utinyint; 3];

// 1 << n, as a table: the 6502 backends take no run-time shift amount.
const BIT: [utinyint; 3] = [1, 2, 4];

pub mod quad {
    // The window's first text row (block rows); the frame is the row above and the row below the window.
    const TOP: utinyint = 2;

    fn drawFrame() {
        let width: utinyint = REELS * (QUAD_S + 1) + 1;
        let bottom: utinyint = quad::TOP + ROWS * QUAD_S;
        for col: utinyint in 0..width {
            let mut top: utinyint = FRAME_T;
            let mut low: utinyint = FRAME_B;
            if col == 0 {
                top = FRAME_TL;
                low = FRAME_BL;
            } else if col == width - 1 {
                top = FRAME_TR;
                low = FRAME_BR;
            } else if col % (QUAD_S + 1) == 0 {
                top = FRAME_DIVT;
                low = FRAME_DIVB;
            }
            let above: usmallint = layout::cell(col, quad::TOP - 1);
            let below: usmallint = layout::cell(col, bottom);
            cells::put(above, cells::frameCode(top));
            cells::put(below, cells::frameCode(low));
            cells::tint(above, 7);
            cells::tint(below, 7);
        }
        // the payline arrows point at the middle of the middle symbol row
        let arrow: utinyint = quad::TOP + QUAD_S + (QUAD_S >> 1);
        for row: utinyint in quad::TOP..bottom {
            let mut left: utinyint = FRAME_L;
            let mut right: utinyint = FRAME_R;
            if row == arrow {
                left = FRAME_ARROW_L;
                right = FRAME_ARROW_R;
            }
            let side: usmallint = layout::cell(0, row);
            cells::put(side, cells::frameCode(left));
            cells::put(side + width - 1, cells::frameCode(right));
            cells::tint(side, 7);
            cells::tint(side + width - 1, 7);
            for reel: utinyint in 1..REELS {
                cells::put(side + reel * (QUAD_S + 1), cells::frameCode(FRAME_DIV));
                cells::tint(side + reel * (QUAD_S + 1), 2);
            }
        }
    }

    // One display row: QUAD_S cells at `at`, from pseudo-pixel row `r` of the strip symbol at stop `i` (`strip` is
    // the reel's offset into STRIPS). `flip` inverts the cells (the win flash).
    fn drawRow(strip: usmallint, i: utinyint, r: utinyint, at: usmallint, flip: bool) {
        let symbol: usmallint = STRIPS[strip + i];
        let k: usmallint = r >> 1;
        let mut base: usmallint = 0;
        if cells::COLORED {
            // The ink: the symbol cell the row's upper pseudo-pixel row is in; where that cell has no ink (0) and the
            // row's lower half is in the next cell down (an odd start), that cell's.
            let mut inkRow: usmallint = symbol * QUAD_S + k;
            inkRow = inkRow * QUAD_S;
            for c: utinyint in 0..QUAD_S {
                let mut ink: utinyint = QUAD_K[inkRow + c];
                if ink == 0 && (r & 1) == 1 {
                    if r < QUAD_P - 1 {
                        ink = QUAD_K[inkRow + QUAD_S + c];
                    } else {
                        let mut after: usmallint = STRIPS[strip + (i + 1 & STOP_MASK)];
                        after = after * QUAD_S;
                        ink = QUAD_K[after * QUAD_S + c];
                    }
                }
                cells::tint(at + c, ink);
            }
        }
        if (r & 1) == 0 {
            base = symbol * QUAD_S + k;
            base = base * QUAD_S;
            for c: utinyint in 0..QUAD_S {
                let mut code: utinyint = QUAD_C0[base + c];
                if flip {
                    code = cells::invert(code);
                }
                cells::put(at + c, code);
            }
        } else if r < QUAD_P - 1 {
            base = symbol * (QUAD_S - 1) + k;
            base = base * QUAD_S;
            for c: utinyint in 0..QUAD_S {
                let mut code: utinyint = QUAD_C1[base + c];
                if flip {
                    code = cells::invert(code);
                }
                cells::put(at + c, code);
            }
        } else {
            let next: usmallint = STRIPS[strip + (i + 1 & STOP_MASK)];
            base = symbol * QUAD_SYMBOLS + next;
            base = base * QUAD_S;
            for c: utinyint in 0..QUAD_S {
                let mut code: utinyint = QUAD_CX[base + c];
                if flip {
                    code = cells::invert(code);
                }
                cells::put(at + c, code);
            }
        }
    }

    // Draw `reel` at its current position: ROWS * QUAD_S cell rows of QUAD_S cells.
    fn drawReel(reel: utinyint) {
        let mut stop: utinyint = reelscroll::stop(reel);
        // The window's top row within its symbol: QUAD_P rows of 4 pixels each.
        let mut line: utinyint = reelscroll::row(reel) >> 2;
        drawnRow[reel] = line;
        drawnStop[reel] = stop;
        let mut strip: usmallint = reel;
        strip = strip * STOPS;
        // The cell address walks down a row (text.COLUMNS) at a time: no multiply.
        let mut at: usmallint = layout::cell(1 + reel * (QUAD_S + 1), quad::TOP);
        let mut band: utinyint = 0; // which symbol row of the window this cell row belongs to
        let mut third: utinyint = 0;
        for down: utinyint in 0..ROWS * QUAD_S {
            quad::drawRow(strip, stop, line, at, (inverted[reel] & BIT[band]) != 0);
            at = at + text::COLUMNS;
            third = third + 1;
            if third == QUAD_S {
                third = 0;
                band = band + 1;
            }
            // two pseudo-pixel rows on
            line = line + 2;
            if line >= QUAD_P {
                line = line - QUAD_P;
                stop = stop + 1 & STOP_MASK;
            }
        }
    }

    // `by` whole cell rows (8 or 16 pixels) of scroll, the window's phase unchanged: every row of the reel moves down
    // `by` and the new top rows are composed. `line` and `stop` are the window's new top row and stop.
    fn hop(reel: utinyint, stop: utinyint, line: utinyint, by: utinyint) {
        let mut strip: usmallint = reel;
        strip = strip * STOPS;
        let mut top: usmallint = layout::cell(1 + reel * (QUAD_S + 1), quad::TOP);
        move::down(scr::SCREEN + top, ROWS * QUAD_S, QUAD_S, text::COLUMNS, by);
        if cells::COLORED {
            move::down(scr::COLOR + top, ROWS * QUAD_S, QUAD_S, text::COLUMNS, by);
        }
        drawnRow[reel] = line;
        drawnStop[reel] = stop;
        let mut l: utinyint = line;
        let mut s: utinyint = stop;
        for i: utinyint in 0..by {
            quad::drawRow(strip, s, l, top, false);
            top = top + text::COLUMNS;
            l = l + 2;
            if l >= QUAD_P {
                l = l - QUAD_P;
                s = s + 1 & STOP_MASK;
            }
        }
    }

    // ---- what the game calls ---------------------------------------------

    fn begin() {
        for reel: utinyint in 0..REELS {
            inverted[reel] = 0;
            drawnRow[reel] = 255;
            drawnStop[reel] = 255;
        }
        quad::drawFrame();
    }

    fn draw(reel: utinyint) {
        quad::drawReel(reel);
    }

    fn drawAll() {
        for reel: utinyint in 0..REELS {
            quad::drawReel(reel);
        }
    }

    // A reel moved `pixels` down. Nothing to do until it has moved a whole pseudo-pixel row (four pixels); a move of
    // one or two cell rows (two or four pseudo-pixel rows, the same phase) is a hop where the screen can be copied;
    // anything else is a full redraw.
    fn moved(reel: utinyint, pixels: utinyint) {
        let stop: utinyint = reelscroll::stop(reel);
        let line: utinyint = reelscroll::row(reel) >> 2;
        if drawnRow[reel] == line && drawnStop[reel] == stop {
            return;
        }
        if scr::COPY && drawnRow[reel] != 255 && inverted[reel] == 0 {
            // how many pseudo-pixel rows up the strip the window went: positions are stop * QUAD_P + row
            let mut was: usmallint = drawnStop[reel];
            was = was * QUAD_P + drawnRow[reel];
            let mut now: usmallint = stop;
            now = now * QUAD_P + line;
            let mut gone: usmallint = was + STOPS * QUAD_P - now;
            if gone >= STOPS * QUAD_P {
                gone = gone - STOPS * QUAD_P;
            }
            if gone == 2 {
                quad::hop(reel, stop, line, 1);
                return;
            }
            if gone == 4 {
                quad::hop(reel, stop, line, 2);
                return;
            }
        }
        quad::drawReel(reel);
    }

    // Light payline `line` by inverting the symbols on it, or put them back.
    fn flashLine(line: utinyint, on: bool) {
        for reel: utinyint in 0..REELS {
            let bit: utinyint = BIT[LINES[line * REELS + reel]];
            if on {
                inverted[reel] = inverted[reel] | bit;
            } else {
                inverted[reel] = inverted[reel] & 255 - bit;
            }
            quad::drawReel(reel);
        }
    }
}
