// The reels on the PET: the quadrant composer (quad.8bs), in four-pixel steps (a whole cell row, eight pixels,
// is a block copy), no colour. The block is 22 columns wide on a 40-column screen; under it a blank row, then three lines of text.
// The game calls only this interface; see view.8bs for what each function means.
use @8bitscript::text::text;
use "@shared/layout.8bs"::layout;
use self::quad::quad;

pub mod view {
    // ---- where everything else goes, in cells from the block's left edge ----
    const BLOCK_WIDTH: utinyint = 22;
    const CREDIT_ROW: utinyint = 22;
    const CREDIT_NUM: utinyint = 7;
    const BET_ROW: utinyint = 22;
    const BET_NUM: utinyint = 20;
    const WIN_ROW: utinyint = 23;
    const WIN_NUM: utinyint = 7;
    const MESSAGE_ROW: utinyint = 24;
    const MESSAGE_COL: utinyint = 0;
    const MESSAGE_WIDTH: utinyint = 22;

    fn statics() {
        text::print(layout::cell(0, 0), "VEGAS NIGHTS 3X3");
        text::print(layout::cell(0, 22), "CREDIT");
        text::print(layout::cell(16, 22), "BET");
        text::print(layout::cell(0, 23), "WIN");
        text::print(layout::cell(16, 23), "UP DOWN: BET");
    }

    fn begin() {
        quad::begin();
    }

    fn draw(reel: utinyint) {
        quad::draw(reel);
    }

    fn drawAll() {
        quad::drawAll();
    }

    fn moved(reel: utinyint, pixels: utinyint) {
        quad::moved(reel, pixels);
    }

    fn flashLine(line: utinyint, on: bool) {
        quad::flashLine(line, on);
    }

    // The reels are drawn straight to the screen here: nothing is held back to show later.
    fn flush() {
    }

    fn sync() {
    }
}
