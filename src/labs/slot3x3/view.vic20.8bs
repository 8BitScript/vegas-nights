// The reels on the VIC-20: the quadrant composer (quad.8bs), in four-pixel steps (a whole cell row, eight pixels,
// is a block copy of the screen and of the colour RAM), in colour. The block is the whole 22-column screen; under it a
// blank row and one line of credit and bet. The win and the message go on the top row, where the title would be.
// The game calls only this interface; see view.8bs for what each function means.
use @8bitscript::text::text;
use "@shared/layout.8bs"::layout;
use self::quad::quad;

pub mod view {
    // ---- where everything else goes, in cells from the block's left edge ----
    const BLOCK_WIDTH: utinyint = 22;
    const CREDIT_ROW: utinyint = 22;
    const CREDIT_NUM: utinyint = 3;
    const BET_ROW: utinyint = 22;
    const BET_NUM: utinyint = 14;
    const WIN_ROW: utinyint = 0;
    const WIN_NUM: utinyint = 4;
    const MESSAGE_ROW: utinyint = 0;
    const MESSAGE_COL: utinyint = 11;
    const MESSAGE_WIDTH: utinyint = 11;

    fn statics() {
        text::print(layout::cell(0, 0), "WIN");
        text::print(layout::cell(0, 22), "CR");
        text::print(layout::cell(10, 22), "BET");
    }

    fn begin() {
        quad::begin();
    }

    fn draw(reel: utinyint) {
        quad::draw(reel);
    }

    fn drawAll() {
        quad::drawAll();
    }

    fn moved(reel: utinyint, pixels: utinyint) {
        quad::moved(reel, pixels);
    }

    fn flashLine(line: utinyint, on: bool) {
        quad::flashLine(line, on);
    }

    // The reels are drawn straight to the screen here: nothing is held back to show later.
    fn flush() {
    }

    fn sync() {
    }
}
