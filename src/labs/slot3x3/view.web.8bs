// The reels on the web: the quadrant composer (quad.8bs) on the host font's sixteen 2x2 block glyphs (codes 128-143), in
// four-pixel steps, in colour: the same picture the PET draws, bigger on a bigger grid. Nothing in the runtime changed
// for it; the web redraws a reel whole each step (the host has no screen memory to copy, scr.COPY is false).
// The game calls only this interface; see view.8bs for what each function means.
import { text } from "@8bitscript/text";
import { layout } from "@shared/layout.8bs";
import { quad } from "./quad.8bs";

export namespace view {
    // ---- where everything else goes, in cells from the block's left edge ----
    const BLOCK_WIDTH: utinyint = 22;
    const CREDIT_ROW: utinyint = 21;
    const CREDIT_NUM: utinyint = 7;
    const BET_ROW: utinyint = 22;
    const BET_NUM: utinyint = 7;
    const WIN_ROW: utinyint = 23;
    const WIN_NUM: utinyint = 7;
    const MESSAGE_ROW: utinyint = 24;
    const MESSAGE_COL: utinyint = 0;
    const MESSAGE_WIDTH: utinyint = 22;

    function statics(): void {
        text.print(layout.cell(0, 0), "VEGAS NIGHTS 3X3");
        text.print(layout.cell(0, 21), "CREDIT");
        text.print(layout.cell(0, 22), "BET");
        text.print(layout.cell(0, 23), "WIN");
        text.print(layout.cell(14, 22), "UP DOWN: BET");
    }

    function begin(): void {
        quad.begin();
    }

    function draw(reel: utinyint): void {
        quad.draw(reel);
    }

    function drawAll(): void {
        quad.drawAll();
    }

    function moved(reel: utinyint, pixels: utinyint): void {
        quad.moved(reel, pixels);
    }

    function flashLine(line: utinyint, on: bool): void {
        quad.flashLine(line, on);
    }

    // The reels are drawn straight to the screen here: nothing is held back to show later.
    function flush(): void {
    }

    function sync(): void {
    }
}
