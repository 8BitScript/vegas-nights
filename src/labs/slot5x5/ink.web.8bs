// The web: a colour a cell, from 16. The tileset for the web has 2x2 cells a symbol and
// the composer's symbols are 3x3 cells, so a cell takes the first non-black colour of
// its symbol's four — one ink a symbol, which is what the PET-style art has anyway.
import { text } from "@8bitscript/text";
import { SYMBOL_COLOR } from "@generated/tiles/cosmic.8bs";

export namespace ink {
    function cell(at: usmallint, symbol: utinyint, index: utinyint): void {
        let color: utinyint = 1;
        for (let i: utinyint = 0; i < 4; i++) {
            let c: utinyint = SYMBOL_COLOR[symbol * 4 + 3 - i];
            if (c != 0) {
                color = c;
            }
        }
        text.putColor(at, color);
    }
}
