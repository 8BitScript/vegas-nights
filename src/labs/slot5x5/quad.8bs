// The 5x5's reels from the quadrant blocks every Commodore character ROM holds (and the web's host font): a character
// cell is a 2x2 picture, so the screen is a grid of "pseudo-pixels" four real pixels on a side. Used by the PET (whose
// ROM is fixed), the VIC-20 (whose RAM has no room reserved for a character set) and the web. A symbol is QUAD_S x
// QUAD_S cells (4 x 4 on the PET and the web, 32 pixels a side; 3 x 3 on the 22-column VIC-20, 24), five reels with a
// divider between each pair, and a reel scrolls one pseudo-pixel row, four real pixels, at a time.
//
// It is the 3x3's composer (labs/slot3x3/quad.8bs) with five reels: every display cell is built from two consecutive
// pseudo-pixel rows of the window, so its screen code is one of three precomputed tables (tools/tiles/src/quadtables.mjs):
// QUAD_C0 when the pair starts on an even row, QUAD_C1 on an odd one, QUAD_CX where an odd pair straddles two symbols. A
// reel that moves a whole cell row (8 pixels) or two does not recompose: where the machine's screen is in memory
// (scr.COPY) it MOVES its cells down with a 6502 block copy (the hop, shared/move.8bs) and composes only the new top
// row. The picture is exactly the one a full redraw makes. Where the machine is coloured, a cell's ink comes from QUAD_K.
//
// The 5x5 has ways, not lines: a win lights the symbol rows that took part (flashRows), and the bonus round holds the
// frame in gold (pulse).
import { text } from "@8bitscript/text";
import { cells } from "@shared/cells.8bs";
import { layout } from "@shared/layout.8bs";
import { move } from "@shared/move.8bs";
import { scr } from "@shared/scr.8bs";
import { spin } from "./spin.8bs";
import { quadcode } from "./quadcode.8bs";
import { geometry } from "./geometry.8bs";
import { REELS, ROWS, STOPS, STOP_MASK, STRIPS } from "@generated/grid5x5.8bs";
import {
    QUAD_S, QUAD_P, QUAD_SYMBOLS, QUAD_C0, QUAD_C1, QUAD_CX, QUAD_K
} from "@generated/tiles/cosmic.quad.8bs";
import {
    FRAME_TL, FRAME_T, FRAME_TR, FRAME_L, FRAME_R, FRAME_BL, FRAME_B, FRAME_BR,
    FRAME_DIV, FRAME_DIVT, FRAME_DIVB
} from "@generated/tiles/cosmic.pet.8bs";

// Per reel: the stop and pseudo-pixel row last drawn (so a 2-pixel step that does not reach the next row costs
// nothing, and a whole-cell move is told from a jump), and which of its symbol rows are shown inverted (the
// win flash).
let drawnRow: array<utinyint, 5>;
let drawnStop: array<utinyint, 5>;
let inverted: array<utinyint, 5>;

// 1 << n, as a table: the 6502 backends take no run-time shift amount.
const BIT: array<utinyint, 5> = [1, 2, 4, 8, 16];
const GOLD_FRAME: utinyint = 7;     // the reel frame's colour for the whole bonus round: yellow, the gold of the Gold look

export namespace quad {
    // The window's first text row (block rows); the frame is the row above and the row below the window.
    const TOP: utinyint = geometry.TOP;

    function drawFrame(): void {
        let width: utinyint = REELS * (QUAD_S + 1) + 1;
        let bottom: utinyint = quad.TOP + ROWS * QUAD_S;
        for (let col: utinyint = 0; col < width; col++) {
            let top: utinyint = FRAME_T;
            let low: utinyint = FRAME_B;
            if (col == 0) {
                top = FRAME_TL;
                low = FRAME_BL;
            } else if (col == width - 1) {
                top = FRAME_TR;
                low = FRAME_BR;
            } else if ((col % (QUAD_S + 1)) == 0) {
                top = FRAME_DIVT;
                low = FRAME_DIVB;
            }
            let above: usmallint = layout.cell(col, quad.TOP - 1);
            let below: usmallint = layout.cell(col, bottom);
            cells.put(above, quadcode.frame(top));
            cells.put(below, quadcode.frame(low));
            cells.tint(above, 7);
            cells.tint(below, 7);
        }
        for (let row: utinyint = quad.TOP; row < bottom; row++) {
            let left: utinyint = FRAME_L;
            let right: utinyint = FRAME_R;
            let side: usmallint = layout.cell(0, row);
            cells.put(side, quadcode.frame(left));
            cells.put(side + width - 1, quadcode.frame(right));
            cells.tint(side, 7);
            cells.tint(side + width - 1, 7);
            for (let reel: utinyint = 1; reel < REELS; reel++) {
                cells.put(side + reel * (QUAD_S + 1), quadcode.frame(FRAME_DIV));
                cells.tint(side + reel * (QUAD_S + 1), 2);
            }
        }
    }

    // One display row: QUAD_S cells at `at`, from pseudo-pixel row `r` of the strip symbol at stop `i` (`strip` is
    // the reel's offset into STRIPS). `flip` inverts the cells (the win flash).
    function drawRow(strip: usmallint, i: utinyint, r: utinyint, at: usmallint, flip: bool): void {
        let symbol: usmallint = STRIPS[strip + i];
        let k: usmallint = r >> 1;
        let base: usmallint = 0;
        if (cells.COLORED) {
            // The ink: the symbol cell the row's upper pseudo-pixel row is in; where that cell has no ink (0) and the
            // row's lower half is in the next cell down (an odd start), that cell's.
            let inkRow: usmallint = symbol * QUAD_S + k;
            inkRow = inkRow * QUAD_S;
            for (let c: utinyint = 0; c < QUAD_S; c++) {
                let ink: utinyint = QUAD_K[inkRow + c];
                if (ink == 0 && (r & 1) == 1) {
                    if (r < QUAD_P - 1) {
                        ink = QUAD_K[inkRow + QUAD_S + c];
                    } else {
                        let after: usmallint = STRIPS[strip + ((i + 1) & STOP_MASK)];
                        after = after * QUAD_S;
                        ink = QUAD_K[after * QUAD_S + c];
                    }
                }
                cells.tint(at + c, ink);
            }
        }
        if ((r & 1) == 0) {
            base = symbol * QUAD_S + k;
            base = base * QUAD_S;
            for (let c: utinyint = 0; c < QUAD_S; c++) {
                let code: utinyint = QUAD_C0[base + c];
                if (flip) {
                    code = cells.invert(code);
                }
                cells.put(at + c, code);
            }
        } else if (r < QUAD_P - 1) {
            base = symbol * (QUAD_S - 1) + k;
            base = base * QUAD_S;
            for (let c: utinyint = 0; c < QUAD_S; c++) {
                let code: utinyint = QUAD_C1[base + c];
                if (flip) {
                    code = cells.invert(code);
                }
                cells.put(at + c, code);
            }
        } else {
            let next: usmallint = STRIPS[strip + ((i + 1) & STOP_MASK)];
            base = symbol * QUAD_SYMBOLS + next;
            base = base * QUAD_S;
            for (let c: utinyint = 0; c < QUAD_S; c++) {
                let code: utinyint = QUAD_CX[base + c];
                if (flip) {
                    code = cells.invert(code);
                }
                cells.put(at + c, code);
            }
        }
    }

    // Draw `reel` at its current position: ROWS * QUAD_S cell rows of QUAD_S cells.
    function drawReel(reel: utinyint): void {
        let stop: utinyint = spin.stop(reel);
        // The window's top row within its symbol: QUAD_P rows of 4 pixels each.
        let line: utinyint = spin.row(reel) >> 2;
        drawnRow[reel] = line;
        drawnStop[reel] = stop;
        let strip: usmallint = reel;
        strip = strip * STOPS;
        // The cell address walks down a row (text.COLUMNS) at a time: no multiply.
        let at: usmallint = layout.cell(1 + reel * (QUAD_S + 1), quad.TOP);
        let band: utinyint = 0;  // which symbol row of the window this cell row belongs to
        let third: utinyint = 0;
        for (let down: utinyint = 0; down < ROWS * QUAD_S; down++) {
            quad.drawRow(strip, stop, line, at, (inverted[reel] & BIT[band]) != 0);
            at = at + text.COLUMNS;
            third = third + 1;
            if (third == QUAD_S) {
                third = 0;
                band = band + 1;
            }
            // two pseudo-pixel rows on
            line = line + 2;
            if (line >= QUAD_P) {
                line = line - QUAD_P;
                stop = (stop + 1) & STOP_MASK;
            }
        }
    }

    // `by` whole cell rows (8 or 16 pixels) of scroll, the window's phase unchanged: every row of the reel moves down
    // `by` and the new top rows are composed. `line` and `stop` are the window's new top row and stop.
    function hop(reel: utinyint, stop: utinyint, line: utinyint, by: utinyint): void {
        let strip: usmallint = reel;
        strip = strip * STOPS;
        let top: usmallint = layout.cell(1 + reel * (QUAD_S + 1), quad.TOP);
        move.down(scr.SCREEN + top, ROWS * QUAD_S, QUAD_S, text.COLUMNS, by);
        if (cells.COLORED) {
            move.down(scr.COLOR + top, ROWS * QUAD_S, QUAD_S, text.COLUMNS, by);
        }
        drawnRow[reel] = line;
        drawnStop[reel] = stop;
        let l: utinyint = line;
        let s: utinyint = stop;
        for (let i: utinyint = 0; i < by; i++) {
            quad.drawRow(strip, s, l, top, false);
            top = top + text.COLUMNS;
            l = l + 2;
            if (l >= QUAD_P) {
                l = l - QUAD_P;
                s = (s + 1) & STOP_MASK;
            }
        }
    }

    // ---- what the game calls ---------------------------------------------

    function begin(): void {
        for (let reel: utinyint = 0; reel < REELS; reel++) {
            inverted[reel] = 0;
            drawnRow[reel] = 255;
            drawnStop[reel] = 255;
        }
        quad.drawFrame();
    }

    function draw(reel: utinyint): void {
        quad.drawReel(reel);
    }

    function drawAll(): void {
        for (let reel: utinyint = 0; reel < REELS; reel++) {
            quad.drawReel(reel);
        }
    }

    // A reel moved `pixels` down. Nothing to do until it has moved a whole pseudo-pixel row (four pixels); a move of
    // one or two cell rows (two or four pseudo-pixel rows, the same phase) is a hop where the screen can be copied;
    // anything else is a full redraw.
    function moved(reel: utinyint, pixels: utinyint): void {
        let stop: utinyint = spin.stop(reel);
        let line: utinyint = spin.row(reel) >> 2;
        if (drawnRow[reel] == line && drawnStop[reel] == stop) {
            return;
        }
        if (scr.COPY && drawnRow[reel] != 255 && inverted[reel] == 0) {
            // how many pseudo-pixel rows up the strip the window went: positions are stop * QUAD_P + row
            let was: usmallint = drawnStop[reel];
            was = was * QUAD_P + drawnRow[reel];
            let now: usmallint = stop;
            now = now * QUAD_P + line;
            let gone: usmallint = was + STOPS * QUAD_P - now;
            if (gone >= STOPS * QUAD_P) {
                gone = gone - STOPS * QUAD_P;
            }
            if (gone == 2) {
                quad.hop(reel, stop, line, 1);
                return;
            }
            if (gone == 4) {
                quad.hop(reel, stop, line, 2);
                return;
            }
        }
        quad.drawReel(reel);
    }

    // Light the symbol rows of `reel` set in `mask` (bit 0 = the top symbol) by inverting them, or put them back.
    function flashRows(reel: utinyint, mask: utinyint, on: bool): void {
        if (on) {
            inverted[reel] = inverted[reel] | mask;
        } else {
            inverted[reel] = inverted[reel] & (255 - mask);
        }
        quad.drawReel(reel);
    }

    // The bonus round's frame: every frame cell in gold, held (where the machine has colour; the PET's frame stays as it is).
    function pulse(phase: utinyint): void {
        if (!cells.COLORED) {
            return;
        }
        let width: utinyint = REELS * (QUAD_S + 1) + 1;
        let bottom: utinyint = quad.TOP + ROWS * QUAD_S;
        for (let col: utinyint = 0; col < width; col++) {
            cells.tint(layout.cell(col, quad.TOP - 1), GOLD_FRAME);
            cells.tint(layout.cell(col, bottom), GOLD_FRAME);
        }
        for (let row: utinyint = quad.TOP; row < bottom; row++) {
            cells.tint(layout.cell(0, row), GOLD_FRAME);
            cells.tint(layout.cell(width - 1, row), GOLD_FRAME);
        }
    }

    function unpulse(): void {
        quad.drawFrame();
    }
}
