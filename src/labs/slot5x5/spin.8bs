// How the 5x5's reels move, in pixels. The same schedule as shared/reelscroll.8bs
// (a blur far from the stop, finer and finer steps in, the last step landing exactly
// on the drawn stop with the reel at rest) with one difference: a symbol is not
// always 24 pixels tall. On the machines that redefine characters (C64, X16) the 5x5
// uses 16x16 art — two cells a symbol, so that five reels fit in the 127 free glyph
// codes — and on the machines that build the reels from the ROM's quadrant blocks
// (PET, VIC-20) it uses 3x3 cells, 24 pixels. A position is the symbol on the window's
// top row (`stop`) and the pixel row within it (`row`, 0..symbol-1); scrolling down
// counts DOWN, and `start` fixes the whole distance in advance so the draw, not the
// picture, decides the outcome.
use "@shared/feel.8bs"::feel;
use "@shared/glyphs.8bs"::glyphs;

let mut stops: [utinyint; 5];
let mut rows: [utinyint; 5];
let mut remaining: [usmallint; 5];
let mut waits: [utinyint; 5];

pub mod spin {
    // Pixels in one symbol on this machine.
    fn size() -> utinyint {
        if glyphs::AVAILABLE {
            return 16;
        }
        return 24;
    }

    fn place(reel: utinyint, stop: utinyint) {
        stops[reel] = stop;
        rows[reel] = 0;
        remaining[reel] = 0;
        waits[reel] = reel;
    }

    // Put `reel` at `stop` with `row` pixels already scrolled into that symbol and no spin
    // under way: a reel held at any pixel offset, for the offset probe that checks the
    // composers (src/labs/slot5x5/offsets.8bs). Nothing in a game calls it.
    fn pin(reel: utinyint, stop: utinyint, row: utinyint) {
        stops[reel] = stop;
        rows[reel] = row;
        remaining[reel] = 0;
        waits[reel] = reel;
    }

    fn stop(reel: utinyint) -> utinyint {
        return stops[reel];
    }

    fn row(reel: utinyint) -> utinyint {
        return rows[reel];
    }

    fn moving(reel: utinyint) -> bool {
        return remaining[reel] != 0;
    }

    // Pixels from stop `a` down the strip to stop `b` (wrapping), for a strip of `count` stops.
    fn distance(a: utinyint, b: utinyint, count: utinyint) -> usmallint {
        let mut around: usmallint = count;
        let mut origin: usmallint = a;
        let mut to: usmallint = b;
        if glyphs::AVAILABLE {
            around = around << 4;
            origin = origin << 4;
            to = to << 4;
        } else {
            around = around * 24;
            origin = origin * 24;
            to = to * 24;
        }
        let mut extra: usmallint = origin + around;
        extra = extra - to;
        while extra >= around {
            extra = extra - around;
        }
        return extra;
    }

    // Start `reel` toward stop `target` on a strip of `count` stops: at least
    // `minimum` pixels (a multiple of a symbol), then however many more it takes.
    fn start(reel: utinyint, target: utinyint, minimum: usmallint, count: utinyint) {
        let mut around: usmallint = count;
        if glyphs::AVAILABLE {
            around = around << 4;
        } else {
            around = around * 24;
        }
        let mut total: usmallint = spin::distance(stops[reel], target, count);
        while total < minimum {
            total = total + around;
        }
        remaining[reel] = total;
        waits[reel] = reel;
    }

    // Call once a frame. Returns the pixels the reel moved down (0 if it did not
    // move this frame); the caller redraws the reel when it is not 0.
    fn step(reel: utinyint, count: utinyint) -> utinyint {
        if remaining[reel] == 0 {
            return 0;
        }
        if waits[reel] != 0 {
            waits[reel] = waits[reel] - 1;
            return 0;
        }
        let left: usmallint = remaining[reel];
        let sym: utinyint = spin::size();
        let mut pixels: utinyint = feel::FAR;
        let mut wait: utinyint = feel::WAIT;
        if glyphs::AVAILABLE {
            // 16-pixel symbols: 8 a redraw far out (fewer where the machine's own far step is smaller: the X16
            // draws a row three pixels tall, so 8 rows would be 24 pixels a frame, half a symbol), then 4
            // within two symbols, then 2.
            pixels = 8;
            if feel::FAR < 8 {
                pixels = feel::FAR;
            }
            if left <= 32 {
                pixels = 4;
            }
            if left <= 8 {
                pixels = 2;
                wait = feel::WAIT + 1;
            }
        } else {
            if pixels > 12 && left <= 192 {
                pixels = 12;
            }
            if pixels > 8 && left <= 96 {
                pixels = 8;
            }
            if left <= 24 {
                pixels = 4;
            }
            if left <= 8 {
                pixels = 2;
                wait = feel::WAIT + 1;
            }
        }
        // slide the window up the strip by `pixels`
        let mut at: utinyint = rows[reel];
        if at < pixels {
            at = at + sym;
            stops[reel] = stops[reel] - 1 & count - 1;
        }
        rows[reel] = at - pixels;
        remaining[reel] = left - pixels;
        waits[reel] = wait;
        return pixels;
    }
}
