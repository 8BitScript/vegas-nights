// The reels on the vic20: the quadrant composer (quad.8bs), in four-pixel steps.
// The game calls only this interface; see view.8bs for what each function means.
use self::quad::quad;

pub mod view {
    const WIDTH: utinyint = 21;
    const PANEL: utinyint = 17;
    const TITLE: bool = false;

    fn begin() {
        quad::begin();
    }

    fn draw(reel: utinyint) {
        quad::draw(reel);
    }

    fn drawAll() {
        quad::drawAll();
    }

    fn moved(reel: utinyint, pixels: utinyint) {
        quad::moved(reel, pixels);
    }

    fn flashRows(reel: utinyint, mask: utinyint, on: bool) {
        quad::flashRows(reel, mask, on);
    }

    fn pulse(phase: utinyint) {
        quad::pulse(phase);
    }

    fn unpulse() {
        quad::unpulse();
    }
}
