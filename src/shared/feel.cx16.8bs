// The X16 redraws a reel in ~0.25 of a frame: every reel, every frame, 8 pixels
// each — 480 pixels a second, smooth.
export namespace feel {
    const WAIT: utinyint = 0;
    const FAR: utinyint = 8;
    const REEL_WAIT: utinyint = 0;
    const REEL_FAR: utinyint = 8;
    const EASE: utinyint = 24; // a symbol (3 cells) here
}
