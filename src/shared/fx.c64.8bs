// The bonus round on the C64: a warm gold glow round the edge of the screen. "Gold" is one ramp
// -- brown, orange, light red, yellow, a white peak, and back down to brown -- laid on the border
// in seven wide stripes that creep down the frame one notch at a time. Nothing else changes
// colour: the playfield, the reels, the panel and the rows under it are the plain black they
// always are.
//
// How it is built, and why (docs/fx-brief.md has the evidence, with 16 consecutive frames):
//
//   * Border only. The first version also painted the background register in the five rows under
//     the panel and put it back to black at raster lines 1 and 254. The reel composer writes the
//     redefined characters with the I/O area banked out, a window in which the interrupt that
//     applies the list cannot be acknowledged (packages/c64/AGENTS.md, "Interrupt-free windows"),
//     and a frame in which that window swallowed a reset left the background at a stripe colour
//     for the whole picture: a solid-colour flash, 4 frames in 16. The background register is
//     not in this list at all now, so a playfield flash cannot happen, whatever the composer does.
//   * Seven entries, not fifty-four, and wide stripes. A reel redraw is two 80-byte copies in one
//     window (about 2,200 cycles, 35 raster lines), and up to five of them run back to back, so a
//     stripe boundary that falls inside a window is applied when the window ends: late by up to
//     35 lines, and two boundaries in one window merge. 21-line stripes (the first try) therefore
//     merged in pairs and their edges bounced from frame to frame. A stripe 36 lines high cannot
//     merge with its neighbour, and the ramp never goes to black, so neighbouring stripes differ by
//     one soft notch and a late edge is a gentle shift, not a bright jump. (Letting the interrupt
//     in between chunks of the copy was tried and made it worse: it lost the whole pass, a solid
//     border, in 1 frame of 7. See docs/fx.md, "The C64".)
//   * No wobble. The $D016 banner wobble sheared the banner and tore the top reel row (its reset
//     to 0 landed late). The banner glows instead (slot5x5's game loop), moving not one pixel.
//   * A step is a colour, not a position, and it is clocked by VIDEO frames. Each stripe's colour
//     moves one notch along the ramp every STEP video frames, counted by the handler itself
//     (raster.frame()), so a game-loop pass that spans two frames still steps on time. Only the
//     colour byte of each entry is rewritten, one byte store each (raster.setValue); the lines and
//     addresses never change, so the interrupt never reads a half-built entry.
//
// The list is fx's own: the slots call no graphics.update(), no sprite layer, no second list.
// end() disables the interrupt, empties the list and puts the border and background back to black.
//
// Bytes (8bs build c64 --program slot5x5 --size): see docs/fx.md.
import { raster, Register } from "@8bitscript/c64/raster";
import { screen } from "@8bitscript/c64/screen";

// The ramp, in C64 colour numbers: brown, brown, orange, light red, yellow, white, yellow, light
// red, orange, brown. Ten notches; the seven stripes show seven of them at a time.
const GOLD: array<utinyint, 10> = [9, 9, 8, 10, 7, 1, 7, 10, 8, 9];

const STRIPES: utinyint = 7;      // border stripes, one raster entry each
const FIRST: utinyint = 15;       // the first stripe's line (the top of the visible border)
const PITCH: utinyint = 36;       // lines to a stripe: lines 15, 51, ... 231
const STEP: utinyint = 5;         // video frames to a step of the glow
const NOTCHES: utinyint = 10;     // length of the ramp
const ENTRY: utinyint = 4;        // bytes to a list entry (raster.STRIDE)

let phase: utinyint = 0;          // how far along the ramp stripe 0 is
let banked: utinyint = 0;         // video frames counted towards the next step
let lastFrame: utinyint = 0;      // raster.frame() at the last look

// The ramp's colour for stripe `k`: the glow moves down the frame as the phase grows.
function colourOf(k: utinyint): utinyint {
    let at: utinyint = k + NOTCHES - phase;
    if (at >= NOTCHES) {
        at = at - NOTCHES;
    }
    return GOLD[at];
}

export namespace fx {
    const RASTER: bool = #fact(video.raster);

    function begin(): void {
        phase = 0;
        banked = 0;
        raster.clear();
        for (let k: utinyint = 0; k < STRIPES; k++) {
            raster.at(FIRST + k * PITCH, Register.BORDER, colourOf(k));
        }
        raster.enable();
        lastFrame = raster.frame();
    }

    function frame(tick: utinyint): void {
        // The handler counts every video frame, so a pass of the game loop that took two
        // still banks two.
        let now: utinyint = raster.frame();
        banked = banked + (now - lastFrame);
        lastFrame = now;
        if (banked >= STEP) {
            banked = banked - STEP;
            phase = phase + 1;
            if (phase >= NOTCHES) {
                phase = 0;
            }
            for (let k: utinyint = 0; k < STRIPES; k++) {
                raster.setValue(k * ENTRY, colourOf(k));
            }
        }
    }

    function end(): void {
        raster.disable();
        raster.clear();
        raster.commit();
        screen.setColors(0, 0);
    }
}
