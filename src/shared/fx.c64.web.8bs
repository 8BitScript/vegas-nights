// The bonus round on the C64's wasm build: the same warm gold glow as the real C64, through the
// portable raster list. fx.c64.8bs builds the C64's own address-form list (@8bitscript/c64/raster,
// an interrupt that writes a register at the end of chosen raster lines), which is machine code
// the wasm backend never lowers. The page applies the portable list (@8bitscript/raster: BORDER
// at a picture line) to the same registers' pixels at paint time, so the same glow is expressed
// in that:
//
//   * Border only: the border takes a new colour every 17 picture lines, from line 0 to 187 --
//     twelve stripes of the ramp black, brown, orange, light red, yellow, white and back,
//     creeping down one notch every STEP frames. Both side borders show it.
//   * The background is never written: the playfield and the rows under the panel are the plain
//     black they always are, and nothing wobbles.
//
// What the wasm build cannot show: the machine's stripes also run through the border above and
// below the 200 picture lines (raster lines 15-49 and 250-255), where a picture-line list has no
// line to name. The page paints that border in its plain colour.
//
// The wasm build runs one game-loop pass to a video frame, so a step is exactly STEP frames.
// end() empties the list; the page reads the registers again, and nothing here wrote them.
import { raster, Slot } from "@8bitscript/raster";

// The ramp, in C64 colour numbers: black, brown, orange, light red, yellow, white, back.
const GOLD: array<utinyint, 12> = [0, 9, 8, 10, 7, 1, 7, 10, 8, 9, 0, 0];

const STRIPES: utinyint = 12;     // border stripes, one raster entry each
const PITCH: utinyint = 17;       // picture lines to a stripe: 0, 17, ... 187
const STEP: utinyint = 5;         // frames to a step of the glow

let phase: utinyint = 0;
let waiting: utinyint = 0;

function colourOf(k: utinyint): utinyint {
    let at: utinyint = k + 12 - phase;
    if (at >= 12) {
        at = at - 12;
    }
    return GOLD[at];
}

export namespace fx {
    const RASTER: bool = #fact(video.raster);

    function begin(): void {
        phase = 0;
        waiting = STEP - 1;
        raster.clear();
        for (let k: utinyint = 0; k < STRIPES; k++) {
            raster.at(k * PITCH, Slot.BORDER, colourOf(k));
        }
        raster.enable();
    }

    function frame(tick: utinyint): void {
        if (waiting == 0) {
            waiting = STEP - 1;
            phase = phase + 1;
            if (phase >= 12) {
                phase = 0;
            }
            for (let k: utinyint = 0; k < STRIPES; k++) {
                raster.setValue(k * raster.STRIDE, colourOf(k));
            }
        } else {
            waiting = waiting - 1;
        }
    }

    function end(): void {
        raster.disable();
        raster.clear();
        raster.commit();
    }
}
