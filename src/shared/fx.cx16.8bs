// The bonus round on the Commander X16: a warm gold glow in the border, palette-cycled.
//
// The X16 can do something the other raster machines cannot: a raster entry's BORDER value is
// a *palette index* (0-255), and VERA's palette is plain video memory the CPU can rewrite in a
// few dozen bytes. So the border stripes are not rewritten raster entries; they are twelve
// raster entries written ONCE, each naming its own palette entry, and the animation is the
// palette: every STEP video frames the twelve entries' RGB are rewritten from a 24-step gold table, one
// notch further along, so a smooth glow slides down the frame without the raster list being
// touched.
//
// "Gold" (docs/fx-brief.md) is one ramp -- black, deep brown, orange, amber, gold, cream, a
// white-yellow peak, and back -- in 24 steps that differ by one or two levels of VERA's 12-bit
// colour, so a step is a soft shift, never a jump. Stripe k (picture lines 20 * k) shows step
// (2k - phase) of the table: about six stripes make one swell of the glow.
//
//   * Border only. The first version also coloured the background's palette entry nine times down
//     the rows under the panel, a hard white and cyan glow band, and cycled four unrelated bars
//     (gold, magenta, cyan, green): 35 colours in a frame. The background is held at black now, so
//     no digit or reel ever sits on a glow.
//   * No wobble: it would move the title and banner rows. The reels, panel, meters and frame
//     are cells; none of them is touched.
//
// The reel composer streams tile bytes through VERA's DATA0, and frame() writes the palette
// through DATA0 too, but the raster handler saves and restores ADDR0 and CTRL around every
// write, frame() sets its own address, and the composer sets its own before each copy, so the
// two cannot tear each other (packages/cx16/AGENTS.md, "Raster splits").
//
// end() puts back the border colour and the twelve palette entries it read in begin(), and
// lets one more frame carry a list of a single plain entry (border as it was, background black)
// before the handler is taken off, so the screen is exactly what it was before the round.
//
// Bytes (8bs build cx16 --program slot5x5 --size, program / RAM): see docs/fx.md.
import { raster, Slot } from "@8bitscript/raster";
import { setVramAddress } from "@8bitscript/cx16";

// The gold table: 24 steps, VERA palette format. GB is GGGGBBBB, R is 0000RRRR. A triangle from
// black up through brown, orange, amber and gold to a cream peak at step 12 and back down.
const GOLD_GB: array<utinyint, 24> = [
    0x00, 0x10, 0x10, 0x20, 0x30, 0x50, 0x60, 0x81,
    0xA1, 0xC2, 0xD5, 0xE8, 0xFB, 0xE8, 0xD5, 0xC2,
    0xA1, 0x81, 0x60, 0x50, 0x30, 0x20, 0x10, 0x10,
];
const GOLD_R: array<utinyint, 24> = [
    0x00, 0x02, 0x03, 0x05, 0x07, 0x0A, 0x0C, 0x0D,
    0x0E, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F, 0x0F,
    0x0E, 0x0D, 0x0C, 0x0A, 0x07, 0x05, 0x03, 0x02,
];

const STRIPES: utinyint = 12;      // border stripes, one raster entry each
const PITCH: utinyint = 20;        // picture lines per stripe: 0, 20, ... 220
const FIRST: utinyint = 64;        // the first palette entry the stripes use (nothing else does)
const PALETTE_BYTES: utinyint = 24; // two bytes an entry
const STEP: utinyint = 4;          // video frames to a step of the glow

// VERA palette entry FIRST: video memory $1FA00 + 2 * FIRST.
const PALETTE_AT: usmallint = 0xFA80;

let savedPalette: array<utinyint, 24>;
let savedBorder: utinyint = 0;
let phase: utinyint = 0;           // how far along the table stripe 0 is, 0..23
let banked: utinyint = 0;          // video frames counted towards the next step
let lastFrame: utinyint = 0;       // raster.frame() at the last look

// Write the twelve stripes' palette entries for the current phase.
function paint(): void {
    setVramAddress(1, PALETTE_AT, 1);
    for (let k: utinyint = 0; k < STRIPES; k++) {
        let step: utinyint = k * 2 + 24 - phase;
        if (step >= 24) {
            step = step - 24;
        }
        memory.write(0x9F23, GOLD_GB[step]);
        memory.write(0x9F23, GOLD_R[step]);
    }
}

export namespace fx {
    const RASTER: bool = #fact(video.raster);

    function begin(): void {
        savedBorder = memory.read(0x9F2C);
        setVramAddress(1, PALETTE_AT, 1);
        for (let i: utinyint = 0; i < PALETTE_BYTES; i++) {
            savedPalette[i] = memory.read(0x9F23);
        }
        phase = 0;
        banked = 0;
        paint();

        // The list, written once, in line order: a black background at line 0 and a border
        // stripe every PITCH lines naming its own palette entry.
        raster.clear();
        raster.at(0, Slot.BACKGROUND, 0);
        for (let k: utinyint = 0; k < STRIPES; k++) {
            raster.at(k * PITCH, Slot.BORDER, FIRST + k);
        }
        raster.commit();
        raster.enable();
        lastFrame = raster.frame();
    }

    function frame(tick: utinyint): void {
        // The raster handler counts every video frame (raster.frame()), so a game-loop pass
        // that spans two frames still banks two.
        let now: utinyint = raster.frame();
        banked = banked + (now - lastFrame);
        lastFrame = now;
        if (banked >= STEP) {
            banked = banked - STEP;
            phase = phase + 1;
            if (phase >= 24) {
                phase = 0;
            }
            paint();
        }
    }

    function end(): void {
        // One more frame with a single plain entry, so the handler leaves the border and the
        // background's palette entry exactly as they were; then the handler goes.
        raster.clear();
        raster.at(0, Slot.BORDER, savedBorder);
        raster.at(0, Slot.BACKGROUND, 0);
        raster.commit();
        waitFrame();
        waitFrame();
        raster.disable();
        memory.write(0x9F25, 0x00);
        memory.write(0x9F2C, savedBorder);
        setVramAddress(1, PALETTE_AT, 1);
        for (let i: utinyint = 0; i < PALETTE_BYTES; i++) {
            memory.write(0x9F23, savedPalette[i]);
        }
    }
}
