// The bonus round on the PET: a marquee of chasing lights, written straight into screen RAM. The PET has one ink, no border, no colour and a fixed character ROM, so the effect
// is made of what the screen map can say: the ROM's solid, shade and quarter-block characters and
// its reverse video, from const tables, in cells the game never reads.
//
//   * Marquee. A ring of dots runs round the edge of the screen (the top and bottom rows and the
//     left and right columns: the 5x5 block and its panel leave all four free) and four comets (a solid block, then a
//     shade, then back to a dot) chase round it, one cell every four frames each, a different
//     comet on every frame. This is the whole of the motion in the margins: the first version
//     also dropped six `$` coins down the margins and blinked eight `*` stars on and off, and in
//     the motion strips (docs/fx-brief.md) those isolated single characters appearing and
//     vanishing at scattered cells read as screen noise, not as confetti. A smooth chase is
//     the one thing here that reads as intentional, so it is the one thing left.
//   * Banner. There is no title row on the PET (view.TITLE is false), so "-- FREE SPINS --"
//     goes on the free row under the panel (row 23), and a block of reverse video scans along
//     it, a cell every fourth frame.
//
// What it does NOT do, and why. The PET's only raster effect is the character-set split on the
// 3032/4032 (@8bitscript/pet/rasterline, Slot.CHARSET). Its driver busy-waits down the frame to
// the last entry's line (about 5,209 + 50 cycles a line of a ~20,000-cycle frame), and the
// quadrant composer that draws the five reels already needs most of the rest of it, so a split
// over the banner row (line 184) would take nearly the whole frame from the reels. A split over
// the reels would turn their block graphics into letters. So RASTER here is not
// #fact(video.raster): it is true on every PET, because frame() does something on all of them.
//
// What it touches, and puts back. Only cells outside the machine: the screen's four edges (rows 0
// and 24, columns 0 and COLUMNS - 1) and row 23. The block is rows 1-22 and the panel the eleven
// columns beside it (labs/slot5x5/geometry.8bs, centred by layout.centre()); neither the reels,
// the frame, the panel digits nor the meters are written here. end() puts a space in every cell
// begin() and frame() can have written.
//
// Cost. The PET has almost no time to spare: the quadrant composer that redraws the reels takes
// most of a frame, and any work added to a frame that is already near the limit costs a whole
// frame some of the time. Measured by the frame the forced bonus round ends on (about 3,397
// frames from its start at frame 508 without this file): a first version that worked out each
// cell's address with row * columns (a software multiply on a 6502, three times a cell) ended
// 519 frames later, 15 per cent; with the addresses in tables, 140 later (4 per cent); with the
// work spread so that one comet and one banner cell move on a frame, 52 later (1.5 per
// cent). Nothing here multiplies once the round is running: begin() lays every address into
// tables and frame() only looks them up and adds. See docs/fx.md, "The PET".

import { text } from "@8bitscript/text";
import { cells } from "@shared/cells.8bs";

// Screen codes. The game runs in the PET's text set (upper and lower case), where the letters
// are 1-26 for lower case and 65-90 for capitals; the codes below read the same in both sets.
// 160 is reverse video's solid block; 102 the checkerboard shade; 46 the full stop.
const BLANK: utinyint = 32;
const DOT: utinyint = 46;
const SHADE: utinyint = 102;
const BULB: utinyint = 160;

// The ring is the screen's edge: 2 * columns + 46 places, 126 on a 40-column PET and 206 on an 80-column
// one. An array length cannot be an expression, so the tables are the 80-column size on both.

const COMET_COUNT: utinyint = 4;
const BANNER_LEN: utinyint = 16;
const BANNER_ROW: utinyint = 23;
const LAST_ROW: utinyint = 24;

// "-- FREE SPINS --" as screen codes (capitals are 65-90 in the text set); +128 is the same in
// reverse video.
const BANNER: array<utinyint, 16> = [45, 45, 32, 70, 82, 69, 69, 32, 83, 80, 73, 78, 83, 32, 45, 45];

let pathLength: utinyint = 0;   // cells in the marquee ring
let head: array<utinyint, 4>;   // each comet's head, as a place on the ring
// The screen offset of each place on the ring, as two tables of 16-bit offsets of 103 places
// each: a single table of 206 offsets is 412 bytes, and the 6502 backend indexes one with an
// 8-bit index register, so on an 80-column PET every place from the 128th would land on top of
// one of the first 78. (The 40-column ring has 126 places, so its second table holds 23.)
const RING_HALF: utinyint = 103;
let ringFirst: array<usmallint, 103>;
let ringSecond: array<usmallint, 103>;
let bannerAt: usmallint = 0;    // the first cell of the banner
let bannerPos: utinyint = 0;    // the banner cell in reverse video

// The offset of the cell `row`, `col`. A multiply: begin() only.
function at(row: utinyint, col: utinyint): usmallint {
    let a: usmallint = row;
    a = a * text.COLUMNS;
    a = a + col;
    return a;
}

// The screen offset of place `i` on the ring.
function ringCell(i: utinyint): usmallint {
    if (i < RING_HALF) {
        return ringFirst[i];
    }
    return ringSecond[i - RING_HALF];
}

function setRing(n: utinyint, a: usmallint): void {
    if (n < RING_HALF) {
        ringFirst[n] = a;
    } else {
        ringSecond[n - RING_HALF] = a;
    }
}

// Lay the marquee ring out in the ring tables, by adding and subtracting only. It starts in the top
// left corner and runs right along the top row, down the right column, left along the bottom row and up
// the left column.
function layRing(): void {
    let n: utinyint = 0;
    let a: usmallint = 0;
    for (let i: utinyint = 0; i < text.COLUMNS; i++) {
        setRing(n, a);
        a = a + 1;
        n = n + 1;
    }
    a = a - 1;
    a = a + text.COLUMNS;
    for (let i: utinyint = 0; i < LAST_ROW; i++) {
        setRing(n, a);
        a = a + text.COLUMNS;
        n = n + 1;
    }
    a = a - text.COLUMNS;
    a = a - 1;
    for (let i: utinyint = 1; i < text.COLUMNS; i++) {
        setRing(n, a);
        a = a - 1;
        n = n + 1;
    }
    a = a + 1;
    a = a - text.COLUMNS;
    for (let i: utinyint = 1; i < LAST_ROW; i++) {
        setRing(n, a);
        a = a - text.COLUMNS;
        n = n + 1;
    }
    pathLength = n;
}

function wrapNext(place: utinyint): utinyint {
    let n: utinyint = place + 1;
    if (n >= pathLength) {
        n = 0;
    }
    return n;
}

function wrapPrevious(place: utinyint): utinyint {
    if (place == 0) {
        return pathLength - 1;
    }
    return place - 1;
}

function drawBanner(): void {
    for (let k: utinyint = 0; k < BANNER_LEN; k++) {
        cells.put(bannerAt + k, BANNER[k]);
    }
}

// One comet moves on a place: a new head, the old head becomes shade, the old shade a dot.
function stepComet(k: utinyint): void {
    let was: utinyint = head[k];
    let now: utinyint = wrapNext(was);
    cells.put(ringCell(wrapPrevious(was)), DOT);
    cells.put(ringCell(was), SHADE);
    cells.put(ringCell(now), BULB);
    head[k] = now;
}

export namespace fx {
    const RASTER: bool = true;

    function begin(): void {
        // The block and its panel are inside the screen's edge; the ring runs along the edge itself.
        layRing();
        for (let i: utinyint = 0; i < pathLength; i++) {
            cells.put(ringCell(i), DOT);
        }
        for (let k: utinyint = 0; k < COMET_COUNT; k++) {
            head[k] = (pathLength >> 2) * k;
            cells.put(ringCell(head[k]), BULB);
            cells.put(ringCell(wrapPrevious(head[k])), SHADE);
        }
        bannerAt = at(BANNER_ROW, (text.COLUMNS - BANNER_LEN) >> 1);
        bannerPos = 0;
        drawBanner();
        cells.put(bannerAt, BANNER[0] + 128);
    }

    function frame(tick: utinyint): void {
        // One comet moves on every frame (each comet every fourth): a smooth chase.
        stepComet(tick & 3);
        // The reverse-video block moves to the next banner cell on every fourth frame.
        if ((tick & 3) == 0) {
            cells.put(bannerAt + bannerPos, BANNER[bannerPos]);
            bannerPos = bannerPos + 1;
            if (bannerPos == BANNER_LEN) {
                bannerPos = 0;
            }
            cells.put(bannerAt + bannerPos, BANNER[bannerPos] + 128);
        }
    }

    function end(): void {
        for (let i: utinyint = 0; i < pathLength; i++) {
            cells.put(ringCell(i), BLANK);
        }
        for (let k: utinyint = 0; k < BANNER_LEN; k++) {
            cells.put(bannerAt + k, BLANK);
        }
    }
}
