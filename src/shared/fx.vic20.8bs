// The bonus round on the VIC-20: a slow, warm border glow and a marquee of lights up the screen's
// last column. Both are nearly free on this machine; the raster bars the other machines get
// are not, and the cost is measured, so it is written down here.
//
//   * Why no copper bars. The VIC-I has no raster interrupt: @8bitscript/raster applies a list
//     from waitFrame()'s frame hook, which busy-waits from the top of the frame down to the last
//     planned line (packages/vic20/AGENTS.md, "Raster splits"). The quadrant composer needs the
//     better part of a frame for a redraw, so a hook that holds the CPU for even the top third
//     of the frame pushes every composing frame past its edge. Measured with eight stripes six
//     lines apart (the top 42 lines): the forced bonus round that the portable stub finishes at
//     video frame ~10,200 finished at ~18,200 — reels 78% slower — and the code grew by 1.9 KB.
//     The effect cost the game its speed to draw a few stripes, so there are none.
//   * The same measure ruled out the first marquee, which rewrote all 23 cells' colours every
//     frame (a 16-bit multiply a cell for its address): ~13,800, 35% slower, with no hook at all.
//     A frame that composes a reel has roughly a tenth of a frame to spare. So the marquee below
//     keeps its 23 addresses in a table and moves three short bars by repainting four cells a bar
//     every second frame: about a seventh of that work.
//   * The border glow. The VIC-I's border has eight colours and no ramp between them, so "Gold" here
//     is two: red and yellow, the warm pair, one change every 8 passes of the game loop (a pass is
//     two or three video frames while the quadrant composer works, so one change in twenty or so
//     frames: a slow breathing, not a flash). $900F's three border bits are written once, right
//     after waitFrame() returns, and ONLY when the colour is to change and the beam is still in
//     the top few lines ($9004, the raster counter): on a pass the composer overran, waitFrame()
//     returns at once in the middle of the picture, a write there would leave the border split
//     (the upper part in the old colour, the lower in the new, a different row each time -- 5 of 58
//     captured frames before), so the change waits for the next pass that arrives on time. Even an
//     on-time write lands a few lines into the frame (the counter reads 4-7, 8-14 lines down), so
//     on the frame of a change the first dozen rows of the border still show the old colour: a
//     strip under 6% of the picture, one frame in twenty. The VIC-I has no way to change a global
//     register exactly at the frame boundary without a hook that costs the reels 78%. Bits
//     3-7 -- the background colour the reels' blank quadrants are drawn on, and the inverse flag --
//     are read back and kept. A read and, rarely, a write: no hook, no wait.
//   * The marquee. The block is 21 columns on a 22-column screen (layout.centre leaves the last
//     column empty on every row), so column 21 is a 16-pixel strip nothing is drawn in. begin()
//     fills it with solid blocks in a dim blue; three lit bars (white head, yellow, red) travel
//     down it, wrapping, eight rows apart. No glyph is redefined; not one reel, panel or meter cell
//     is touched. end() puts back spaces and the colours it found.
import { vicColor } from "@8bitscript/vic20";
import { Video } from "@8bitscript/vic20/geometry";

// The marquee: the screen's last column, all 23 rows, as offsets into the screen and colour
// RAM (the VIC-20's text grid is always 22 x 23). A table, not 22 * row + 21 a cell.
const ROWS: utinyint = 23;
const AT: array<usmallint, 23> = [
    21, 43, 65, 87, 109, 131, 153, 175, 197, 219, 241, 263,
    285, 307, 329, 351, 373, 395, 417, 439, 461, 483, 505,
];
const SOLID: utinyint = 160;
const SPACE: utinyint = 32;
const DIM: utinyint = 6;

// A bar, head first: white, yellow, red, then the dim tube again behind it.
const TRAIL: array<utinyint, 4> = [1, 7, 2, 6];

// The border's two colours, the warm pair: red, then yellow.
const WARM: array<utinyint, 2> = [2, 7];
// A colour holds for 8 game-loop passes (tick >> 3): about twenty video frames.
const TOP: utinyint = 10;        // $9004 below this is the top of the frame ($9004 counts lines / 2; measured: always under 8 when the pass is on time)
const RASTER_COUNTER: usmallint = 0x9004;

// What colour RAM held in the marquee's cells, and what the border was, to put back; and the
// first bar's head row.
let saved: array<utinyint, 23>;
let border: utinyint = 0;
let head: utinyint = 0;
let shown: utinyint = 255;        // the border colour last written (255: none yet)

// Paint one bar: its head on `top` and its trail up the rows behind it, wrapping at the top.
function bar(top: utinyint): void {
    for (let t: utinyint = 0; t < 4; t++) {
        let row: utinyint = top + ROWS - t;
        if (row >= ROWS) {
            row = row - ROWS;
        }
        memory.write(Video.COLOR + AT[row], TRAIL[t]);
    }
}

export namespace fx {
    const RASTER: bool = true;

    function begin(): void {
        border = vicColor & 7;
        for (let row: utinyint = 0; row < ROWS; row++) {
            saved[row] = memory.read(Video.COLOR + AT[row]);
            memory.write(Video.SCREEN + AT[row], SOLID);
            memory.write(Video.COLOR + AT[row], DIM);
        }
        head = 0;
        shown = 255;
        bar(0);
        bar(8);
        bar(16);
    }

    function frame(tick: utinyint): void {
        let want: utinyint = WARM[(tick >> 3) & 1];
        if (want != shown) {
            if (memory.read(RASTER_COUNTER) < TOP) {
                vicColor = (vicColor & 0xF8) | want;
                shown = want;
            }
        }
        if ((tick & 1) == 0) {
            head = head + 1;
            if (head >= ROWS) {
                head = 0;
            }
            let second: utinyint = head + 8;
            if (second >= ROWS) {
                second = second - ROWS;
            }
            let third: utinyint = head + 16;
            if (third >= ROWS) {
                third = third - ROWS;
            }
            bar(head);
            bar(second);
            bar(third);
        }
    }

    function end(): void {
        vicColor = (vicColor & 0xF8) | border;
        for (let row: utinyint = 0; row < ROWS; row++) {
            memory.write(Video.SCREEN + AT[row], SPACE);
            memory.write(Video.COLOR + AT[row], saved[row]);
        }
    }
}
