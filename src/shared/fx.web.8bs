// The bonus round on the web: the same warm gold glow as the C64. The web's renderer applies a
// raster list at paint time (@8bitscript/raster, #fact(video.raster) true, 64 entries, border and
// background colours per picture line), so the whole effect is a list of twelve border stripes
// built once in begin(), with only its colour bytes rewritten, one notch along the ramp, every
// STEP frames. The wasm build runs one game-loop pass to a video frame, so a step is exactly
// STEP frames apart.
//
//   * Border only, 21 lines to a stripe, a ramp of black, brown, orange, light red, yellow,
//     a white peak and back (docs/fx-brief.md, "Gold"). The background is held at black, so
//     no digit or reel ever sits on a bar.
//   * No wobble: it would shift the cells the player and the tests read, and the web has no
//     banner row to animate (view.TITLE is false).
//
// The reel composer writes glyphs and screen codes, never the raster list, so the two do not meet.
// end() empties the list and turns the renderer back to the plain picture.
import { raster, Slot } from "@8bitscript/raster";

// The ramp, in the C64 palette the web uses: black, brown, orange, light red, yellow, white, back.
const GOLD: array<utinyint, 12> = [0, 9, 8, 10, 7, 1, 7, 10, 8, 9, 0, 0];

const STRIPES: utinyint = 12;     // border stripes, one raster entry each
const PITCH: utinyint = 21;       // picture lines to a stripe: 0, 21, ... 231
const STEP: utinyint = 5;         // frames to a step of the glow

let phase: utinyint = 0;
let waiting: utinyint = 0;

function colourOf(k: utinyint): utinyint {
    let at: utinyint = k + 12 - phase;
    if (at >= 12) {
        at = at - 12;
    }
    return GOLD[at];
}

// The byte offset of stripe `k`'s entry in the list (entry 0 is the black background).
function entryOf(k: utinyint): utinyint {
    let index: utinyint = 1 + k;
    return index * raster.STRIDE;
}

export namespace fx {
    const RASTER: bool = #fact(video.raster);

    function begin(): void {
        phase = 0;
        waiting = STEP - 1;
        raster.clear();
        raster.at(0, Slot.BACKGROUND, 0);
        for (let k: utinyint = 0; k < STRIPES; k++) {
            let line: usmallint = k;
            line = line * PITCH;
            raster.at(line, Slot.BORDER, colourOf(k));
        }
        raster.commit();
        raster.enable();
    }

    function frame(tick: utinyint): void {
        if (waiting == 0) {
            waiting = STEP - 1;
            phase = phase + 1;
            if (phase >= 12) {
                phase = 0;
            }
            for (let k: utinyint = 0; k < STRIPES; k++) {
                raster.setValue(entryOf(k), colourOf(k));
            }
            raster.commit();
        } else {
            waiting = waiting - 1;
        }
    }

    function end(): void {
        raster.disable();
        raster.clear();
        raster.commit();
    }
}
