// The machine layer under the reel view: can this machine redefine character
// glyphs while a program runs, and how are their bytes written?
//
// This base file is the answer "no": a lab that asks `glyphs.AVAILABLE` gets
// false, the pixel reel view folds away entirely (a build costs nothing for what
// it cannot use), and the lab draws its reels the fallback way — whole cells, in
// the machine's own character set. A machine that can has a twin beside this
// file (glyphs.c64.8bs, ...). The interface a twin answers:
//
//   AVAILABLE   true: glyphs can be redefined.
//   FIRST       the first glyph code a reel may use (the lab maps its cells to
//               FIRST + n and rewrites those glyphs' bytes as a reel scrolls).
//   CODES       how many codes from FIRST are free to use.
//   EXTRA       how many more codes sit just BELOW FIRST that a lab which never prints
//               them is also free to use (the C64's PETSCII graphics, screen codes
//               91-127, which the portable text never draws): a lab's glyph block runs
//               from FIRST - EXTRA, so a bigger reel window than FIRST..FIRST+CODES holds
//               still fits. 0 where there is no such range.
//   PORT        false: glyph bytes are memory-mapped, `address(code)` is where.
//               true: bytes go to a write port that steps along by itself
//               (the X16's VERA data register), after `seek(code)`.
//   address(code)  where glyph `code`'s eight bytes live (memory-mapped only).
//   seek(code)     point the write port at glyph `code` (port only).
//   open() / close()  bracket a run of writes (the C64 banks its I/O area out).
//   TILE_RAM / stage / composeRow  (memory-mapped machines with an assembly
//                  composer): the tileset is staged byte by byte into RAM at
//                  TILE_RAM once, and composeRow(first, second, dest, run, rest)
//                  copies three glyphs' worth from there, `run` bytes from the
//                  address `first` then `rest` from `second`, per glyph.
//   symbols(count, bytes)  once, before the first reel draw: how many symbols the staged
//                  tileset holds and how many bytes each takes (the composer finds symbol n
//                  at TILE_RAM + n * bytes). A machine whose composer needs no table does nothing.
//   put(at, code)  the screen code `code` into text cell `at`, raw. text.putChar reads its
//                  argument as ASCII and translates it, which turns the C64's low codes (91-127,
//                  where the graphics sit) into letters, so a glyph block that starts there maps
//                  its cells with this.
//   begin()        once, before the first glyph write.
export namespace glyphs {
    const AVAILABLE: bool = false;
    const FIRST: utinyint = 0;
    const CODES: utinyint = 0;
    const EXTRA: utinyint = 0;
    const PORT: bool = false;
    const PORT_ADDRESS: usmallint = 0;
    const TILE_RAM: usmallint = 0;
    const STRIP_RAM: usmallint = 0;
    // Whether the colour of a reel's cells is pre-laid-out too (the 5x5 on the C64, where
    // recolouring a reel cell by cell in compiled code costs more than redrawing its glyphs).
    const COLOR_STRIP: bool = false;

    function begin(): void {
    }

    function address(code: utinyint): usmallint {
        return 0;
    }

    function seek(code: utinyint): void {
    }

    function stage(index: usmallint, value: utinyint): void {
    }

    function put(at: usmallint, code: utinyint): void {
    }

    function symbols(count: utinyint, bytes: usmallint): void {
    }

    function stageStrip(index: usmallint, value: utinyint): void {
    }

    // A whole reel window in one call (memory-mapped machines with an assembly composer):
    // `rows` cell rows of `across` glyphs, from symbols `down` cell rows tall.
    function drawReel(strip: usmallint, stop: utinyint, row: utinyint, dest: usmallint, mask: utinyint, across: utinyint, down: utinyint, rows: utinyint): void {
    }

    // The pre-composed strip buffer (the 5x5): byte `index` set to `value`, and
    // `count` bytes of it from `source` copied into the glyphs from `code` on.
    function putStrip(index: usmallint, value: utinyint): void {
    }

    function copyOut(code: utinyint, source: usmallint, count: utinyint): void {
    }

    function putColorStrip(index: usmallint, value: utinyint): void {
    }

    // `count` colours from the colour buffer at `source` down a screen column from text cell `cell`.
    function copyColors(cell: usmallint, source: usmallint, count: utinyint): void {
    }

    function open(): void {
    }

    function close(): void {
    }
}
