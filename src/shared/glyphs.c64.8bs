// The C64's glyph layer: the character set the VIC-II draws text from is a copy
// in RAM under the I/O area ($D000, @8bitscript/c64/charset), writable one byte
// at a time while the I/O area is banked out. A reel draw writes hundreds of
// bytes, so it brackets them with ONE open()/close() instead of paying the bank
// switch per glyph the way charset.define does.
//
// Codes 128-255 are the upper-case set's reverse-video copies, which a program
// that never prints reverse text is free to use; the reels take them.
import { setupVideo, bankIoOut, bankIoIn, memoryPointer } from "@8bitscript/c64";
import { Video, screenRam } from "@8bitscript/c64/video";

// Where the tileset is staged for the assembly composer: $C000-$CFFF is plain RAM
// on the C64, outside the video bank's screen, sprite shapes and character copy
// and above any program this size. (A const array is not reachable from an
// asm6502 block, and the compiler lowers no array parameters, so the bytes are
// copied once to an address the block can name.)
@address(0xC000)
let tileBytes: array<utinyint, 1024>;

// …and the reels' strips, a symbol number a stop, right after the tiles.
@address(0xC400)
let stripBytes: array<utinyint, 320>;

// …and where each symbol's tile starts in the tileset: the low and the high byte of its
// address, one entry a symbol (up to sixteen), filled by symbols(). The composer reads a
// symbol's place from here, so a symbol can be any size (24x24 or 32x32 art).
@address(0xC600)
let symbolLow: array<utinyint, 16>;

@address(0xC610)
let symbolHigh: array<utinyint, 16>;

// The 5x5's strips, pre-composed: for every reel and glyph column, the whole strip
// of the column as bytes (512 pixel rows) and the first 80 repeated after it, so
// that any 80 consecutive rows — a reel window at any pixel offset — are one
// contiguous run to copy into ten glyphs. $8000-$9FFF is plain RAM, above any
// program this size.
@address(0x8000)
let stripBuf: array<utinyint, 5920>;

// …and the colours: for every reel and glyph column, the colour of each cell row of the
// strip (64 cell rows, then the first ten again), $9800 up.
@address(0x9800)
let colorBuf: array<utinyint, 740>;

export namespace glyphs {
    const AVAILABLE: bool = true;
    const COLOR_STRIP: bool = true;
    const FIRST: utinyint = 128;
    const CODES: utinyint = 127;
    // Screen codes 91-127 are PETSCII graphics in the mixed-case set, which no text the labs
    // print draws (the portable text is letters, digits and a few marks, all below 91), so
    // they are free too: the 3x3's 32x32 art needs 158 glyphs and FIRST..FIRST+CODES is 127.
    const EXTRA: utinyint = 37;
    const PORT: bool = false;
    const PORT_ADDRESS: usmallint = 0;
    const TILE_RAM: usmallint = 0xC000;
    const STRIP_RAM: usmallint = 0xC400;

    // The ROM-to-RAM character copy and the video mode must exist before the
    // first glyph write; setupVideo() does both and is cheap when done.
    function begin(): void {
        setupVideo();
        // The glyphs are written into the mixed-case set (below), so that is the set to show.
        // @8bitscript/text selects it on its first write; the reel cells are written raw (put),
        // which does not, so it is selected here.
        memoryPointer = Video.MEMORY_POINTER_LOWERCASE;
    }

    // @8bitscript/text keeps the mixed-case set selected ($D018 = MEMORY_POINTER_LOWERCASE:
    // the second half of the character copy, +$0800), so that is the set whose
    // glyphs the screen shows. (charset.define writes the other half; its header
    // says the text package uses that one, which no longer matches text.8bs.)
    function address(code: utinyint): usmallint {
        let offset: usmallint = code;
        offset = offset * 8;
        return Video.CHARSET + 2048 + offset;
    }

    function seek(code: utinyint): void {
    }

    function stage(index: usmallint, value: utinyint): void {
        tileBytes[index] = value;
    }

    // The screen code `code`, as it is, into text cell `at` (the screen matrix is the C64's own).
    function put(at: usmallint, code: utinyint): void {
        screenRam[at] = code;
    }

    function stageStrip(index: usmallint, value: utinyint): void {
        stripBytes[index] = value;
    }

    // Where symbol n's tile starts in the tileset, for the composer: $C000 + n * bytes.
    function symbols(count: utinyint, bytes: usmallint): void {
        let at: usmallint = 0xC000;
        for (let i: utinyint = 0; i < count; i++) {
            let low: utinyint = at & 255;
            let high: utinyint = at >> 8;
            symbolLow[i] = low;
            symbolHigh[i] = high;
            at = at + bytes;
        }
    }

    // A whole reel window in one call: `rows` cell rows of `across` glyphs, composed from the
    // staged tileset ($C000, symbol n at symbolLow/High[n]) according to the staged strip
    // (`strip` is the address of this reel's stops, one symbol number a stop) at the pixel
    // offset given by `stop` (the symbol on the window's top row) and `row` (the pixel row
    // within it, 0 to down * 8 - 1). `dest` is the first of the reel's `rows * across`
    // consecutive glyphs' bytes; `mask` is the number of stops minus one (a power of two).
    // A symbol is `down` cell rows of `across` cells (3x3 for 24x24 art, 4x4 for 32x32), eight
    // bytes a cell, laid out cell row by cell row.
    //
    // Each cell row takes eight pixel rows of the strip from where it is: `run` bytes
    // (8 - within) from the symbol cell it starts in, then `rest` (within) from the one
    // below — the cell under it in the same symbol, or the first of the next symbol — for
    // each of the `across` glyphs, whose sources are 8 bytes apart. The second copy runs
    // with Y from `run` to 7, so `second` is set to the start of that cell less `run`: Y = run
    // then reads its first byte. (It once subtracted `rest`, which is right only at 0 and 4
    // pixels into a cell row; test/composer-offsets.test.mjs draws every offset.) The 3x3's
    // 24x24 version of this was ~6000 cycles; the same loop in compiled script was ~17000
    // and, before the copy was assembly, ~70000.
    function drawReel(strip: usmallint, stop: utinyint, row: utinyint, dest: usmallint, mask: utinyint, across: utinyint, down: utinyint, rows: utinyint): void {
        let first: usmallint = 0;
        let second: usmallint = 0;
        let here: usmallint = 0;
        let run: utinyint = 0;
        let rest: utinyint = 0;
        let band: utinyint = 0;
        let left: utinyint = rows;
        // bytes from one cell row of a symbol to the next, a symbol's height in pixels, and
        // the index of its last cell row
        let stride: utinyint = across << 3;
        let pixH: utinyint = down << 3;
        let last: utinyint = down - 1;
        asm6502 {
        1:
            ldy stop
            lda (strip),y
            tax
            lda $C600,x
            sta here
            lda $C610,x
            sta here+1
            lda row
            and #7
            sta rest
            lda row
            lsr a
            lsr a
            lsr a
            sta band
            lda here
            sta first
            lda here+1
            sta first+1
            ldx band
            beq 3f
        2:
            clc
            lda first
            adc stride
            sta first
            bcc 21f
            inc first+1
        21:
            dex
            bne 2b
        3:
            clc
            lda first
            adc rest
            sta first
            bcc 22f
            inc first+1
        22:
            lda band
            cmp last
            bcs 4f
            sec
            lda first
            sbc rest
            sta second
            lda first+1
            sbc #0
            sta second+1
            clc
            lda second
            adc stride
            sta second
            bcc 23f
            inc second+1
        23:
            jmp 5f
        4:
            lda stop
            clc
            adc #1
            and mask
            tay
            lda (strip),y
            tax
            lda $C600,x
            sta second
            lda $C610,x
            sta second+1
        5:
            lda #8
            sec
            sbc rest
            sta run
            sec
            lda second
            sbc run
            sta second
            lda second+1
            sbc #0
            sta second+1
            ldx across
        6:
            ldy #0
        7:
            lda (first),y
            sta (dest),y
            iny
            cpy run
            bne 7b
            lda rest
            beq 9f
        8:
            lda (second),y
            sta (dest),y
            iny
            cpy #8
            bne 8b
        9:
            clc
            lda first
            adc #8
            sta first
            bcc 10f
            inc first+1
        10:
            clc
            lda second
            adc #8
            sta second
            bcc 11f
            inc second+1
        11:
            clc
            lda dest
            adc #8
            sta dest
            bcc 12f
            inc dest+1
        12:
            dex
            bne 6b
            clc
            lda row
            adc #8
            sta row
            cmp pixH
            bcc 13f
            sec
            sbc pixH
            sta row
            lda stop
            clc
            adc #1
            and mask
            sta stop
        13:
            dec left
            beq 14f
            jmp 1b
        14:
        }
    }

    function putStrip(index: usmallint, value: utinyint): void {
        stripBuf[index] = value;
    }

    // `count` bytes (at most 255) from the strip buffer at `source` into the glyphs
    // starting at `code`: a straight copy, in assembly, with the I/O area banked out.
    function copyOut(code: utinyint, source: usmallint, count: utinyint): void {
        let dest: usmallint = glyphs.address(code);
        let src: usmallint = 0x8000 + source;
        asm6502 {
            ldy #0
        1:
            lda (src),y
            sta (dest),y
            iny
            cpy count
            bne 1b
        }
    }

    function putColorStrip(index: usmallint, value: utinyint): void {
        colorBuf[index] = value;
    }

    // `count` colours from the colour buffer at `source` into colour RAM, one a text row
    // (40 cells) apart, down from text cell `cell`.
    function copyColors(cell: usmallint, source: usmallint, count: utinyint): void {
        let dest: usmallint = 0xD800 + cell;
        let src: usmallint = 0x9800 + source;
        asm6502 {
            ldx count
            ldy #0
        1:
            lda (src),y
            sta (dest),y
            inc src
            bne 2f
            inc src+1
        2:
            clc
            lda dest
            adc #40
            sta dest
            bcc 3f
            inc dest+1
        3:
            dex
            bne 1b
        }
    }

    function open(): void {
        bankIoOut();
    }

    function close(): void {
        bankIoIn();
    }
}
