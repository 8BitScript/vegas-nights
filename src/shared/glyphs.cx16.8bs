// The X16's glyph layer: the text layer draws from a 1bpp 8x8 tileset in VRAM
// (the KERNAL's ISO-8859-15 font at $1F000 today — a ROM build constant, so it
// is read back from L1_TILEBASE), one tile per character code, eight bytes a
// tile. The CPU reaches VRAM only through VERA's data port, which steps along
// by itself: `seek` points it at a tile, and the composer then writes the
// tile's eight bytes (and the next tile's, in code order) to DATA0.
//
// Codes 128-255 are the ISO set's upper half (accented letters and symbols
// this game never prints); the reels and the frame take 128-222.
use @8bitscript::cx16::setVramAddress;
use @8bitscript::text::text;

// The 5x5's pre-composed strips (see glyphs.c64.8bs): in RAM, copied to the tiles
// through VERA's data port.
let mut stripBuf: [utinyint; 5920];

pub mod glyphs {
    const AVAILABLE: bool = true;
    const FIRST: utinyint = 128;
    const CODES: utinyint = 127;
    const EXTRA: utinyint = 0;
    const PORT: bool = true;
    const PORT_ADDRESS: usmallint = 0x9F23; // VERA DATA0
    const TILE_RAM: usmallint = 0;
    const STRIP_RAM: usmallint = 0;
    // Recolouring a reel cell by cell in compiled code is fast enough at 8 MHz.
    const COLOR_STRIP: bool = false;
    const BUFFERED: bool = false;

    // Double buffering (glyphs.8bs): this machine has one copy of the glyph block, so none of it does anything.
    fn target(code: utinyint) -> usmallint {
        return glyphs::address(code);
    }

    fn hiddenBit() -> utinyint {
        return 0;
    }

    fn region(row: utinyint, rows: utinyint) {
    }

    fn mirror(first: utinyint, count: utinyint) {
    }

    fn flip() {
    }

    fn home() {
    }

    fn clone() {
    }

    fn stageColor(index: usmallint, color: utinyint) {
    }

    fn putColors(at: usmallint, source: usmallint, across: utinyint, rows: utinyint) {
    }

    fn begin() {
    }

    fn address(code: utinyint) -> usmallint {
        return 0;
    }

    // Point DATA0 at the first byte of tile `code`, stepping by 1.
    // L1_TILEBASE ($9F36): bits 7:2 are the tileset address bits 16:11.
    fn seek(code: utinyint) {
        let base: utinyint = memory::read(0x9F36) >> 2;
        let mut low: usmallint = base & 31;
        low = low * 2048;
        let mut offset: usmallint = code;
        offset = offset * 8;
        low = low + offset;
        setVramAddress(base >> 5, low, 1);
    }

    fn stage(index: usmallint, value: utinyint) {
    }

    fn symbols(count: utinyint, bytes: usmallint) {
    }

    // Every code the X16's glyph block uses is 128 or more, which text.putChar passes through.
    fn put(at: usmallint, code: utinyint) {
        text::putChar(at, code);
    }

    fn stageStrip(index: usmallint, value: utinyint) {
    }

    fn drawReel(strip: usmallint, stop: utinyint, row: utinyint, dest: usmallint, mask: utinyint, across: utinyint, down: utinyint, rows: utinyint) {
    }

    fn putStrip(index: usmallint, value: utinyint) {
        stripBuf[index] = value;
    }

    // `count` bytes from the strip buffer at `source` into the tiles from `code` on.
    fn copyOut(code: utinyint, source: usmallint, count: utinyint) {
        glyphs::seek(code);
        for i: utinyint in 0..count {
            memory::write(0x9F23, stripBuf[source + i]);
        }
    }

    fn putColorStrip(index: usmallint, value: utinyint) {
    }

    fn copyColors(cell: usmallint, source: usmallint, count: utinyint) {
    }

    fn open() {
    }

    fn close() {
    }
}
