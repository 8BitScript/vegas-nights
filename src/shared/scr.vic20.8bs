// The VIC-20: screen codes at Video.SCREEN (it moves with the RAM fitted) and a colour nybble a cell at Video.COLOR.
import { Video } from "@8bitscript/vic20/geometry";

export namespace scr {
    const COPY: bool = true;
    const SCREEN: usmallint = Video.SCREEN;
    const COLOR: usmallint = Video.COLOR;
}
