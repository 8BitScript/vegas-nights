// The slot machines' sounds: a reel tick, a reel stop, a small win, a big win
// and the bonus fanfare, on whatever the machine has (the SID, the VIC-I, the
// PET's one-bit speaker, the X16's PSG, the web's oscillator) through
// @8bitscript/audio's `audio.tone`.
//
//     sfx.update();      // once a frame, from the game loop, instead of audio.update()
//     sfx.tick();        // a reel steps
//     sfx.stop();        // a reel lands
//     sfx.win();         // a line pays
//     sfx.big();         // a big pay
//     sfx.bonus();       // the bonus round starts
//     sfx.silence();     // stop now
//
// A jingle is a run of steps, a note and how many frames it sounds; it plays
// without blocking, one step at a time from `sfx.update()`, and a new effect
// cuts the old one off (a reel tick must not wait for a fanfare). The data is
// a pair of const arrays, so it is in the program image and not in RAM, and
// the notes are all inside C4..B5 (the .8ba index 48..71, C0 = 0, A4 = 57):
// the range every machine with a sound chip here plays without moving a note
// by an octave, the PET's narrow VIA shift register being the limit.
//
// On a machine with no driver `audio.NOTE_HIGH` is 0, a constant, and every
// call here folds to nothing.
import { audio } from "@8bitscript/audio";

// Effect numbers, and where each one's steps are in NOTE and FRAMES.
const TICK: utinyint = 0;
const STOP: utinyint = 1;
const WIN: utinyint = 2;
const BIG: utinyint = 3;
const BONUS: utinyint = 4;
const NONE: utinyint = 255;

// tick | stop | win | big | bonus, back to back.
const NOTE: array<u8, 30> = [
    67,
    48,
    60, 64, 67, 64, 67,
    48, 52, 55, 60, 64, 67, 71, 67, 71,
    55, 57, 59, 60, 62, 64, 65, 67, 69, 71, 69, 71, 69, 71,
];
const FRAMES: array<u8, 30> = [
    2,
    5,
    3, 3, 3, 3, 8,
    4, 4, 4, 4, 4, 4, 4, 4, 12,
    3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 10,
];
// The first step of each effect, and one past its last.
const FIRST: array<u8, 6> = [0, 1, 2, 7, 16, 30];

let current: utinyint = 255;
let at: utinyint = 0;
let end: utinyint = 0;
let left: utinyint = 0;

// Sound the step at `at`, or end the effect when there are none left.
function step(): void {
    if (at >= end) {
        current = NONE;
        return;
    }
    audio.tone(NOTE[at], FRAMES[at]);
    left = FRAMES[at];
    at = at + 1;
}

function begin(effect: utinyint): void {
    if (audio.NOTE_HIGH == 0) {
        return;
    }
    current = effect;
    at = FIRST[effect];
    end = FIRST[effect + 1];
    step();
}

export namespace sfx {
    function tick(): void {
        begin(TICK);
    }

    function stop(): void {
        begin(STOP);
    }

    function win(): void {
        begin(WIN);
    }

    function big(): void {
        begin(BIG);
    }

    function bonus(): void {
        begin(BONUS);
    }

    function silence(): void {
        current = NONE;
        audio.silence();
    }

    // True while an effect is still sounding.
    function busy(): bool {
        return current != NONE;
    }

    // Once a frame. Counts the sounding step down (this is `audio.update()`)
    // and starts the next one when it has run out.
    function update(): void {
        audio.update();
        if (current == NONE) {
            return;
        }
        left = left - 1;
        if (left == 0) {
            step();
        }
    }
}
