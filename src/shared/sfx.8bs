// When the slot machines make their sounds. HOW they sound is composed in
// assets/audio/classic.8ba (one `song` per sound, notes and rests and instruments); this file
// only decides which one plays, and when, through @8bitscript/audio's `audio.play(song)`.
//
//     sfx.update();      // once a frame, from the game loop
//     sfx.tick();        // a reel passes a symbol
//     sfx.stop();        // a reel comes to rest
//     sfx.win();         // a line pays          sfx.big();  // a big pay
//     sfx.jackpot();     // the jackpot
//     sfx.bonus();       // the bonus round begins          sfx.over();  // ...and ends
//     sfx.cycle();       // off -> low -> normal -> off     sfx.volume();  // 0 off, 1 low, 2 normal
//     sfx.silence();     // stop now
//
// The rules, so that a machine left running is not a nuisance:
//   * Nothing plays on top of something of more importance (a tick never cuts a stop short, a
//     stop never cuts a win), and a sound of equal or more importance replaces what is playing.
//   * A tick is only ever played into silence, and no oftener than every TICK_GAP frames, however
//     many reels are turning.
//   * The volume starts LOW. A one-bit speaker (the PET) cannot be turned down, so at LOW it
//     plays everything but the ticks.
//   * Every sound is a song that ends: when the last row is done the voice is let go.
// On a machine with no sound driver `audio.NOTE_HIGH` is 0 and all of this folds away.
import { audio } from "@8bitscript/audio";
import {
    tickSound, stopSound, winSound, bigSound, jackpotSound, bonusSound, overSound,
} from "@assets/audio/classic.8ba";

// How important each sound is: a lesser one never cuts a greater one off.
const TICK: utinyint = 1;
const STOP: utinyint = 2;
const CUE: utinyint = 3;
const WIN: utinyint = 4;
const BIG: utinyint = 5;
const JACKPOT: utinyint = 6;

// The least gap, in frames, between one tick and the next.
const TICK_GAP: utinyint = 5;

// The player's volume setting: 0 off, 1 low, 2 normal. The audio level each plays at (0..15).
const OFF: utinyint = 0;
const LOW: utinyint = 1;
const NORMAL: utinyint = 2;
const LOW_LEVEL: utinyint = 6;
const NORMAL_LEVEL: utinyint = 11;

let setting: utinyint = 1;
let importance: utinyint = 0;
let gap: utinyint = 0;
let applied: bool = false;

// Put the chip's level where the setting says.
function apply(): void {
    applied = true;
    if (setting == 0) {
        audio.setLevel(0);
    } else if (setting == 1) {
        audio.setLevel(LOW_LEVEL);
    } else {
        audio.setLevel(NORMAL_LEVEL);
    }
}

// Play `song` if nothing more important is sounding.
function begin(song: utinyint, weight: utinyint): void {
    if (audio.NOTE_HIGH == 0 || setting == 0) {
        return;
    }
    if (!applied) {
        apply();
    }
    if (!audio.busy()) {
        importance = 0;
    }
    if (weight < importance) {
        return;
    }
    importance = weight;
    audio.play(song);
}

export namespace sfx {
    function tick(): void {
        if (audio.NOTE_HIGH == 0 || gap != 0 || setting == 0) {
            return;
        }
        // A speaker with one level plays no ticks at the low setting.
        if (audio.LEVEL_MAX < 2 && setting == 1) {
            return;
        }
        if (!applied) {
            apply();
        }
        if (audio.busy()) {
            return;
        }
        gap = TICK_GAP;
        importance = TICK;
        audio.play(tickSound);
    }

    function stop(): void {
        begin(stopSound, STOP);
    }

    function win(): void {
        begin(winSound, WIN);
    }

    function big(): void {
        begin(bigSound, BIG);
    }

    function jackpot(): void {
        begin(jackpotSound, JACKPOT);
    }

    function bonus(): void {
        begin(bonusSound, CUE);
    }

    function over(): void {
        begin(overSound, CUE);
    }

    // Off -> low -> normal -> off... The new level is heard at once, and a sound playing is cut.
    function cycle(): void {
        setting = setting + 1;
        if (setting > 2) {
            setting = 0;
        }
        audio.silence();
        importance = 0;
        apply();
    }

    // 0 off, 1 low, 2 normal.
    function volume(): utinyint {
        return setting;
    }

    function silence(): void {
        audio.silence();
        importance = 0;
    }

    // True while a sound (a song's rests too) is playing.
    function busy(): bool {
        return audio.busy();
    }

    // Once a frame: the song's next step, and the tick gap.
    function update(): void {
        audio.update();
        if (gap != 0) {
            gap = gap - 1;
        }
    }
}
