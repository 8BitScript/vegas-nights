// The game's sound hooks: the game calls these at the moments that should be heard, and
// src/shared/sfx.8bs decides what plays (the sounds themselves are composed in
// assets/audio/classic.8ba). On a machine with no sound driver every call folds to nothing.
//
//   tick      a reel passed a symbol (the game calls it only when a reel's symbol changes)
//   stop      a reel came to rest
//   win       a spin paid          big   a spin paid a lot          jackpot   the jackpot
//   bonus     the bonus round begins          over   ...and ends
//   update    once a frame, from the game loop
//   cycle     the volume key: off -> low -> normal -> off
//   volume    0 off, 1 low, 2 normal (what the panel shows)
import { sfx } from "./sfx.8bs";

export namespace sound {
    function tick(): void {
        sfx.tick();
    }

    function stop(): void {
        sfx.stop();
    }

    function win(): void {
        sfx.win();
    }

    function big(): void {
        sfx.big();
    }

    function jackpot(): void {
        sfx.jackpot();
    }

    function bonus(): void {
        sfx.bonus();
    }

    function over(): void {
        sfx.over();
    }

    function update(): void {
        sfx.update();
    }

    function cycle(): void {
        sfx.cycle();
    }

    function volume(): utinyint {
        return sfx.volume();
    }
}
